{%- comment -%} Vitals Product Information block — refined implementation grafted from MR !14268 (section-local port of the parked PageGen app block). {%- endcomment -%}
{%- liquid
  assign ib_has_visual = false
  if block.settings.icon_type == 'icon' and block.settings.icon != 'none'
    assign ib_has_visual = true
  elsif block.settings.icon_type == 'upload'
    assign ib_has_visual = true
  endif
  case block.settings.alignment
    when 'left'
      assign ib_align = 'flex-start'
    when 'right'
      assign ib_align = 'flex-end'
    else
      assign ib_align = 'center'
  endcase
  assign ib_bg = 'transparent'
  if block.settings.background == 'color'
    assign ib_bg = block.settings.bg_color
  elsif block.settings.background == 'gradient'
    assign ib_bg = block.settings.bg_gradient
  endif
  assign ib_is_anim = false
  if block.settings.background == 'gradient' and block.settings.animate
    assign ib_is_anim = true
  endif
  assign ib_title_stripped = block.settings.title | strip_html | strip
  assign ib_subtitle_stripped = block.settings.subtitle | strip_html | strip
-%}
{% style %}
  .Vtls-{{ block.id }}.PgBanner { position: relative; display: block; background: {{ ib_bg }}; border-radius: {{ block.settings.radius }}px; padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px; margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px;{% if block.settings.border != 'none' %} border: {{ block.settings.border_thickness }}px {{ block.settings.border }} {{ block.settings.border_color }};{% endif %} }
  @media (min-width: 750px) { .Vtls-{{ block.id }}.PgBanner { margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px; } }
  .Vtls-{{ block.id }} .PgBanner__Row { display: flex; flex-direction: column; gap: {{ block.settings.gap }}px; align-items: {{ ib_align }}; text-align: {{ block.settings.alignment }}; }
  .Vtls-{{ block.id }}.PgBanner--withVisual .PgBanner__Row { flex-direction: row; align-items: center; gap: 12px; text-align: left; }
{%- if block.settings.icon_alignment == 'right' %}
  .Vtls-{{ block.id }}.PgBanner--withVisual .PgBanner__Row { flex-direction: row-reverse; text-align: right; }
{%- endif %}
  .Vtls-{{ block.id }} .PgBanner__Visual { flex: 0 0 auto; display: inline-flex; align-items: center; color: {{ block.settings.icon_color }}; }
  .Vtls-{{ block.id }} .PgBanner__Visual .PgI { width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; }
  .Vtls-{{ block.id }} .PgBanner__Visual img { width: {{ block.settings.image_size }}px; height: {{ block.settings.image_size }}px; object-fit: cover; border-radius: {{ block.settings.image_radius }}px; display: block; }
  .Vtls-{{ block.id }} .PgBanner__Text { display: flex; flex-direction: column; gap: {{ block.settings.gap }}px; }
  .Vtls-{{ block.id }} .PgBanner__Title { font-size: {{ block.settings.title_size }}px; color: {{ block.settings.title_color }}; line-height: 1.35; }
  .Vtls-{{ block.id }} .PgBanner__Subtitle { font-size: {{ block.settings.subtitle_size }}px; color: {{ block.settings.subtitle_color }}; line-height: 1.4; }
  .Vtls-{{ block.id }} .PgBanner__Title a, .Vtls-{{ block.id }} .PgBanner__Subtitle a { color: inherit; position: relative; z-index: 2; }
  .Vtls-{{ block.id }} .PgBanner__Link { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  {% if ib_is_anim %}.Vtls-{{ block.id }}.PgBanner { background-size: 300% 300%; animation: PgBanner-keyframes__gradient 10s ease-in-out infinite; }
  @keyframes PgBanner-keyframes__gradient { 0% { background-position: 0% 50%; } 25% { background-position: 50% 100%; } 50% { background-position: 100% 50%; } 75% { background-position: 50% 0%; } 100% { background-position: 0% 50%; } }
  @media (prefers-reduced-motion: reduce) { .Vtls-{{ block.id }}.PgBanner { background-size: auto; animation: none; } }{% endif %}
{% endstyle %}
{%- capture ib_inner -%}
  <div class="PgBanner__Row">
    {%- if ib_has_visual -%}
      <span class="PgBanner__Visual">
        {%- if block.settings.icon_type == 'icon' -%}<span class="PgI PgI--{{ block.settings.icon }}" aria-hidden="true"></span>
        {%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '60, 120, 240' }}
        {%- else -%}<img src="data:image/webp;base64," alt="" width="520" height="520" loading="lazy">{%- endif -%}
      </span>
    {%- endif -%}
    <span class="PgBanner__Text">
      {%- if ib_title_stripped != blank -%}<span class="PgBanner__Title">{{ block.settings.title }}</span>{%- endif -%}
      {%- if ib_subtitle_stripped != blank -%}<span class="PgBanner__Subtitle">{{ block.settings.subtitle }}</span>{%- endif -%}
    </span>
  </div>
{%- endcapture -%}
{%- if ib_title_stripped != blank or ib_subtitle_stripped != blank or ib_has_visual -%}
  {%- assign ib_class = 'Vtls-' | append: block.id | append: ' PgBanner' -%}
  {%- if ib_has_visual -%}{%- assign ib_class = ib_class | append: ' PgBanner--withVisual' -%}{%- endif -%}
  {%- comment -%}
    The whole-banner link is a stretched overlay anchor instead of
    a wrapper: title/subtitle are inline_richtext and may carry
    their own links, and nesting <a> inside <a> is invalid HTML.
    Inline links sit above the overlay (z-index) so both work.
  {%- endcomment -%}
  {%- if block.settings.link != blank -%}
    <div class="{{ ib_class }}" {{ block.shopify_attributes }}>
      {{- ib_inner -}}
      <a class="PgBanner__Link" href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="{{ ib_title_stripped | default: ib_subtitle_stripped | default: 'Learn more' | escape }}"></a>
    </div>
  {%- else -%}
    <div class="{{ ib_class }}" {{ block.shopify_attributes }}>{{ ib_inner }}</div>
  {%- endif -%}
{%- else -%}
  {%- comment -%} All content cleared: keep an editor anchor so the block stays selectable. {%- endcomment -%}
  <div class="vtls-pi__empty-anchor" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{%- endif -%}

