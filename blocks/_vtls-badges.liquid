{%- comment -%} Vitals Product Information block (carved from the v9 single-file section). {%- endcomment -%}
{%- liquid
  assign badge_count = block.settings.badge_count | default: 1 | plus: 0
  assign has_badges = false
  for i in (1..badge_count)
    assign key = 'badge_' | append: i | append: '_text'
    if block.settings[key] != blank
      assign has_badges = true
    endif
  endfor
  case block.settings.alignment
    when 'center'
      assign badges_justify = 'center'
    when 'right'
      assign badges_justify = 'flex-end'
    else
      assign badges_justify = 'flex-start'
  endcase
-%}
{% style %}
  .Vtls-{{ block.id }}.PgBadges { display: flex; flex-wrap: wrap; gap: 8px; justify-content: {{ badges_justify }}; margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px; }
  @media (min-width: 750px) { .Vtls-{{ block.id }}.PgBadges { margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px; } }
  .Vtls-{{ block.id }} .PgBadges__Item { display: inline-flex; align-items: center; gap: 6px; padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px; border-radius: {{ block.settings.radius }}px; font-size: {{ block.settings.text_size }}px; font-weight: {{ block.settings.font_weight }}; line-height: 1.2; }
  .Vtls-{{ block.id }} .PgBadges__Icon { display: inline-flex; flex: 0 0 auto; }
  .Vtls-{{ block.id }} .PgBadges__Icon .PgI { width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; }
{% endstyle %}
{%- if has_badges -%}
  <div class="Vtls-{{ block.id }} PgBadges" {{ block.shopify_attributes }}>
    {%- for i in (1..badge_count) -%}
      {%- liquid
        assign tk = 'badge_' | append: i | append: '_text'
        assign ik = 'badge_' | append: i | append: '_icon'
        assign sk = 'badge_' | append: i | append: '_background'
        assign ck = 'badge_' | append: i | append: '_bg_color'
        assign gk = 'badge_' | append: i | append: '_bg_gradient'
        assign xk = 'badge_' | append: i | append: '_text_color'
        assign bdk = 'badge_' | append: i | append: '_border'
        assign bck = 'badge_' | append: i | append: '_border_color'
        assign btext = block.settings[tk]
      -%}
      {%- if btext != blank -%}
        <span class="PgBadges__Item" style="color: {{ block.settings[xk] }}; background: {% if block.settings[sk] == 'gradient' %}{{ block.settings[gk] }}{% else %}{{ block.settings[ck] }}{% endif %};{% if block.settings[bdk] != 'none' and block.settings[bdk] != blank %} border: 1px {{ block.settings[bdk] }} {{ block.settings[bck] }};{% endif %}">
          {%- assign bicon = block.settings[ik] -%}
          {%- if bicon != 'none' and bicon != blank -%}<span class="PgBadges__Icon"><span class="PgI PgI--{{ bicon }}" aria-hidden="true"></span></span>{%- endif -%}
          <span class="PgBadges__Text">{{ btext }}</span>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}
  {%- comment -%} All badge text cleared: keep an editor anchor so the block stays selectable. {%- endcomment -%}
  <div class="vtls-pi__empty-anchor" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{%- endif -%}

