{%- comment -%} Vitals Product Information block (carved from the v9 single-file section). {%- endcomment -%}
{%- liquid
  assign tabs_count = block.settings.number_of_tabs | plus: 0
  assign tabs_has = false
  for i in (1..tabs_count)
    assign tk = 'tab_' | append: i | append: '_title'
    if block.settings[tk] != blank
      assign tabs_has = true
    endif
  endfor
  assign tabs_bg = ''
  if block.settings.background == 'color'
    assign tabs_bg = block.settings.bg_color
  elsif block.settings.background == 'gradient'
    assign tabs_bg = block.settings.bg_gradient
  endif
-%}
{% style %}
  .Vtls-{{ block.id }}.PgTabs { margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px;{% if tabs_bg != blank %} background: {{ tabs_bg }}; padding: 16px 20px; border-radius: {{ block.settings.corner_radius }}px;{% if block.settings.border == 'solid' %} border: 1px solid {{ block.settings.border_color }};{% endif %}{% endif %} }
  @media (min-width: 750px) { .Vtls-{{ block.id }}.PgTabs { margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px; } }
  {% if block.settings.tab_background == 'dividers' %}.Vtls-{{ block.id }} .PgTabs__Item:not(:last-child) { border-bottom: 1px solid {{ block.settings.divider_color }}; }{% endif %}
  {% if block.settings.tab_background == 'color' %}.Vtls-{{ block.id }} .PgTabs__Item { background: {{ block.settings.tab_bg_color }}; border-radius: {{ block.settings.corner_radius }}px; padding: 4px 16px;{% if block.settings.tab_border == 'solid' %} border: 1px solid {{ block.settings.tab_border_color }};{% endif %} }{% endif %}
  {% if block.settings.space_between > 0 %}.Vtls-{{ block.id }} .PgTabs__Item:not(:first-child) { margin-top: {{ block.settings.space_between }}px; }{% endif %}
  .Vtls-{{ block.id }} .PgTabs__Summary { display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 12px 0; list-style: none; {% if block.settings.text_size_mode == 'custom' %}font-size: {{ block.settings.font_size_custom }}px; {% endif %}color: {{ block.settings.title_color }}; font-weight: {{ block.settings.title_style }}; }
  .Vtls-{{ block.id }} .PgTabs__Summary::-webkit-details-marker { display: none; }
  .Vtls-{{ block.id }} .PgTabs__TitleIcon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; color: {{ block.settings.icon_color }}; }
  .Vtls-{{ block.id }} .PgTabs__TitleIcon .PgI { width: 100%; height: 100%; }
  .Vtls-{{ block.id }} .PgTabs__Title { flex: 1 1 auto; }
  .Vtls-{{ block.id }} .PgTabs__Content { padding: 0 0 12px; max-width: 70ch; color: {{ block.settings.title_color }};{% if block.settings.text_size_mode == 'custom' %} font-size: {{ block.settings.font_size_custom }}px;{% endif %} }
  .Vtls-{{ block.id }} .PgTabs__Content img { max-width: 100%; height: auto; }
  /* Optically matched to the chevron: same 16px box (so switching Accordion
     icon never shifts the row), arms inset to 10px to match the chevron's
     ~9.6px drawn width, and 1.6px bars to match its stroke-width. The bars
     used to span the full box at 2px, which read ~46% wider and heavier than
     the arrows. */
  .Vtls-{{ block.id }} .PgTabs__Ind { flex: 0 0 auto; position: relative; width: 16px; height: 16px; }
  .Vtls-{{ block.id }}.PgTabs--plus_minus .PgTabs__Ind::before, .Vtls-{{ block.id }}.PgTabs--plus_minus .PgTabs__Ind::after { content: ''; position: absolute; background: {{ block.settings.icon_color }}; }
  .Vtls-{{ block.id }}.PgTabs--plus_minus .PgTabs__Ind::before { top: 50%; left: 3px; right: 3px; height: 1.6px; transform: translateY(-50%); }
  .Vtls-{{ block.id }}.PgTabs--plus_minus .PgTabs__Ind::after { left: 50%; top: 3px; bottom: 3px; width: 1.6px; transform: translateX(-50%); transition: opacity .2s ease; }
  .Vtls-{{ block.id }}.PgTabs--plus_minus details[open] .PgTabs__Ind::after { opacity: 0; }
  .Vtls-{{ block.id }} .PgTabs__Chevron { flex: 0 0 auto; width: 16px; height: 16px; transition: transform .2s ease; }
  .Vtls-{{ block.id }} details[open] .PgTabs__Chevron { transform: rotate(180deg); }
{% endstyle %}
{%- if tabs_has -%}
  <div class="Vtls-{{ block.id }} PgTabs PgTabs--{{ block.settings.accordion_icon }}" {{ block.shopify_attributes }}>
    {%- assign tabs_rendered = 0 -%}
    {%- for i in (1..tabs_count) -%}
      {%- assign tk = 'tab_' | append: i | append: '_title' -%}
      {%- assign ck = 'tab_' | append: i | append: '_text' -%}
      {%- assign ik = 'tab_' | append: i | append: '_icon' -%}
      {%- assign tab_title = block.settings[tk] -%}
      {%- if tab_title != blank -%}
        {%- assign tabs_rendered = tabs_rendered | plus: 1 -%}
        {%- assign tab_content = block.settings[ck] -%}
        {%- assign tab_content_stripped = tab_content | strip_html | strip -%}
        {%- assign tab_content_lc = tab_content | downcase -%}
        {%- assign tab_has_media = false -%}
        {%- if tab_content_lc contains '<img' or tab_content_lc contains '<iframe' or tab_content_lc contains '<video' or tab_content_lc contains '<svg' or tab_content_lc contains '<picture' or tab_content_lc contains '<source' or tab_content_lc contains '<embed' or tab_content_lc contains '<audio' or tab_content_lc contains '<object' -%}{%- assign tab_has_media = true -%}{%- endif -%}
        {%- assign vtls_lb = '{' | append: '{' -%}
        {%- comment -%}
          Tab 1 falls back to the live description when its content is blank
          OR still contains unresolved Liquid (a dynamic-source default
          stored literally) - shoppers must never see raw braces.
        {%- endcomment -%}
        {%- if i == 1 and tab_has_media == false -%}
          {%- if tab_content_stripped == blank or tab_content_stripped contains vtls_lb -%}{%- assign tab_content = product.description -%}{%- endif -%}
        {%- endif -%}
        <details class="PgTabs__Item"{% if block.settings.open_first and tabs_rendered == 1 %} open{% endif %}>
          <summary class="PgTabs__Summary">
            {%- assign tab_ic = block.settings[ik] -%}
            {%- if tab_ic != 'none' -%}<span class="PgTabs__TitleIcon"><span class="PgI PgI--{{ tab_ic }}" aria-hidden="true"></span></span>{%- endif -%}
            <span class="PgTabs__Title">{{ tab_title }}</span>
            {%- if block.settings.accordion_icon == 'arrows' -%}<svg class="PgTabs__Chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="{{ block.settings.icon_color }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- else -%}<span class="PgTabs__Ind"></span>{%- endif -%}
          </summary>
          <div class="PgTabs__Content rte">{{ tab_content }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}
  {%- comment -%} All tab titles cleared: keep an editor anchor so the block stays selectable. {%- endcomment -%}
  <div class="vtls-pi__empty-anchor" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{%- endif -%}

