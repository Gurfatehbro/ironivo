{%- comment -%} Vitals Product Information block (carved from the v9 single-file section). {%- endcomment -%}
{%- liquid
  # One source of truth per row: explicit richtext wins, the linked page is
  # the fallback — never both concatenated. Empty rows render only an editor
  # anchor instead of a bare accordion with a default heading.
  assign tab_body = block.settings.content
  if tab_body == blank
    assign tab_body = block.settings.page.content
  endif
-%}
{%- if tab_body != blank -%}
  <details class="vtls-pi__accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
    <summary>
      <span>{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
      <svg class="vtls-pi__accordion-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="vtls-pi__accordion-content rte">
      {{ tab_body }}
    </div>
  </details>
{%- else -%}
  <div class="vtls-pi__empty-anchor" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{%- endif -%}

{%- comment -%}
  PageGen block ports: identical markup/settings to the theme-app-extension
  app blocks (pagegen-badges / pagegen-benefits / pagegen-product-tabs /
  pagegen-atc-button), sharing the same inlined PgI icon library. The
  pagegen-icon snippet render is replaced by an inline `.PgI PgI--<id>` span.
{%- endcomment -%}

{% schema %}
{
  "name": "Collapsible row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping & returns"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "info": "Supports dynamic sources (metafields)."
    },
    {
      "type": "page",
      "id": "page",
      "label": "Content from page"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Collapsible row"
    }
  ]
}
{% endschema %}
