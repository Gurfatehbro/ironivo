{%- comment -%} Vitals Product Information block — refined implementation grafted from MR !14268 (section-local port of the parked PageGen app block). {%- endcomment -%}
{%- liquid
  assign rea_count = block.settings.icon_count | plus: 0
  assign rea_has_items = false
  for i in (1..rea_count)
    assign k = 'item_' | append: i | append: '_title'
    assign rea_probe = block.settings[k] | strip_html | strip
    if rea_probe != blank
      assign rea_has_items = true
    endif
  endfor
  case block.settings.alignment
    when 'left'
      assign rea_align = 'flex-start'
    when 'right'
      assign rea_align = 'flex-end'
    else
      assign rea_align = 'center'
  endcase
  comment
    'vertical' was removed from the Layout options — stored values render as
    the list layout locked to one icon per row (same geometry the option had).
  endcomment
  assign rea_design = block.settings.design
  if rea_design == 'vertical'
    assign rea_design = 'horizontal'
    assign rea_cols = 1
  elsif rea_design == 'boxed'
    assign rea_cols = block.settings.per_row_box | plus: 0
  else
    assign rea_cols = block.settings.per_row | plus: 0
  endif
  assign rea_cols_mobile = block.settings.per_row_mobile | plus: 0
  assign rea_gap = block.settings.icon_gap
  comment
    List and Box carry separate frame settings (same pattern as per_row vs
    per_row_box) so List can default to no frame while Box keeps its card look.
  endcomment
  if rea_design == 'horizontal'
    assign rea_frame_bg = block.settings.background_list
    assign rea_frame_bg_color = block.settings.bg_color_list
    assign rea_frame_bg_gradient = block.settings.bg_gradient_list
    assign rea_frame_border = block.settings.border_list
    assign rea_frame_border_color = block.settings.border_color_list
    assign rea_frame_radius = block.settings.radius_list
    assign rea_frame_pad = block.settings.padding_vertical_list
  else
    assign rea_frame_bg = block.settings.background
    assign rea_frame_bg_color = block.settings.bg_color
    assign rea_frame_bg_gradient = block.settings.bg_gradient
    assign rea_frame_border = block.settings.border
    assign rea_frame_border_color = block.settings.border_color
    assign rea_frame_radius = block.settings.radius
    assign rea_frame_pad = block.settings.padding_vertical
  endif
  assign rea_card_bg = 'transparent'
  if rea_frame_bg == 'color'
    assign rea_card_bg = rea_frame_bg_color
  elsif rea_frame_bg == 'gradient'
    assign rea_card_bg = rea_frame_bg_gradient
  endif
  comment
    Cards and the outer container only get padding while something makes
    them visible (background or border) — a transparent frame would misalign
    the content with the page.
  endcomment
  assign rea_pad_v = 0
  assign rea_pad_h = 0
  if rea_frame_bg != 'none' or rea_frame_border != 'none'
    assign rea_pad_v = rea_frame_pad
    assign rea_pad_h = 12
  endif
  assign rea_container_bg = ''
  if block.settings.container_background == 'color'
    assign rea_container_bg = block.settings.container_bg_color
  elsif block.settings.container_background == 'gradient'
    assign rea_container_bg = block.settings.container_bg_gradient
  endif
  assign rea_container_framed = false
  if rea_container_bg != '' or block.settings.container_border != 'none'
    assign rea_container_framed = true
  endif
-%}
{% style %}
  .Vtls-{{ block.id }}.PgReassure { display: flex; flex-wrap: wrap; gap: {{ rea_gap }}px; color: {{ block.settings.text_color }}; margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px;{% if rea_container_bg != blank %} background: {{ rea_container_bg }};{% endif %}{% if block.settings.container_border != 'none' %} border: 1px {{ block.settings.container_border }} {{ block.settings.container_border_color }};{% endif %}{% if rea_container_framed %} border-radius: {{ block.settings.container_radius }}px; padding: 16px;{% endif %} }
  @media (min-width: 750px) { .Vtls-{{ block.id }}.PgReassure { margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px; } }
  /* Equal flex-basis + grow keeps every cell in a row the same width and lets a
     short last row stretch edge-to-edge: 4 icons under "3 per row" render 3+1
     (full width), 5 render 3+2, and 2 icons under "3 per row" split 50/50. */
  /* border-box: the basis calc must include the cards' padding/border (either
     layout can be framed) — content-box sizing overflows the row and wraps
     3-per-row as 2+1 on themes without a global reset. */
  .Vtls-{{ block.id }} .PgReassure__Item { box-sizing: border-box; flex: 1 1 calc((100% - {{ rea_gap }}px * ({{ rea_cols_mobile }} - 1)) / {{ rea_cols_mobile }}); min-width: 0; padding: {{ rea_pad_v }}px {{ rea_pad_h }}px; background: {{ rea_card_bg }}; border-radius: {{ rea_frame_radius }}px;{% if rea_frame_border != 'none' %} border: 1px {{ rea_frame_border }} {{ rea_frame_border_color }};{% endif %} }
  @media (min-width: 750px) { .Vtls-{{ block.id }} .PgReassure__Item { flex-basis: calc((100% - {{ rea_gap }}px * ({{ rea_cols }} - 1)) / {{ rea_cols }}); } }
  .Vtls-{{ block.id }} .PgReassure__Icon { flex: 0 0 auto; display: inline-flex; align-items: center; color: {{ block.settings.icon_color }}; }
  .Vtls-{{ block.id }} .PgReassure__Icon .PgI { width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; }
  .Vtls-{{ block.id }} .PgReassure__Icon img { display: block; width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; object-fit: contain; }
  .Vtls-{{ block.id }} .PgReassure__Title { font-size: {{ block.settings.text_size }}px; font-weight: {{ block.settings.font_weight }}; line-height: 1.3; min-width: 0; }
  /* inline_richtext allows links — keep them on the configured text color. */
  .Vtls-{{ block.id }} .PgReassure__Title a { color: inherit; }
  .Vtls-{{ block.id }}.PgReassure--horizontal .PgReassure__Item { display: flex; align-items: center; gap: 8px; justify-content: {{ rea_align }}; }
{%- if block.settings.alignment == 'right' %}
  /* Right-aligned list rows put the icon on the outer edge. */
  .Vtls-{{ block.id }}.PgReassure--horizontal .PgReassure__Item { flex-direction: row-reverse; justify-content: flex-start; }
{%- endif %}
  .Vtls-{{ block.id }}.PgReassure--boxed .PgReassure__Item { display: flex; flex-direction: column; gap: 6px; align-items: {{ rea_align }}; text-align: {{ block.settings.alignment }}; }
{% endstyle %}
{%- if rea_has_items -%}
  <div class="Vtls-{{ block.id }} PgReassure PgReassure--{{ rea_design }}" {{ block.shopify_attributes }}>
    {%- for i in (1..rea_count) -%}
      {%- liquid
        assign tk = 'item_' | append: i | append: '_title'
        assign ik = 'item_' | append: i | append: '_icon'
        assign sk = 'item_' | append: i | append: '_icon_style'
        assign ck = 'item_' | append: i | append: '_custom_icon'
        assign rea_title = block.settings[tk]
        assign rea_title_text = rea_title | strip_html | strip
        assign rea_icon_style = block.settings[sk]
        assign rea_custom_icon = block.settings[ck]
      -%}
      {%- if rea_title_text != blank -%}
        <div class="PgReassure__Item">
          {%- if rea_icon_style == 'upload' -%}
            {%- if rea_custom_icon != blank -%}
              <span class="PgReassure__Icon">{{ rea_custom_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>
            {%- endif -%}
          {%- else -%}
            {%- assign rea_icon = block.settings[ik] -%}
            {%- if rea_icon != 'none' and rea_icon != blank -%}<span class="PgReassure__Icon"><span class="PgI PgI--{{ rea_icon }}" aria-hidden="true"></span></span>{%- endif -%}
          {%- endif -%}
          <span class="PgReassure__Title">{{ rea_title }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}
  {%- comment -%} All items cleared: keep an editor anchor so the block stays selectable. {%- endcomment -%}
  <div class="vtls-pi__empty-anchor" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{%- endif -%}

