{% comment %}
  Ironivo Pro Hero Banner - Gripper & Lever Belt Edition
{% endcomment %}

<div class="pro-hero-section">
  <div class="pro-hero-bg">
    <img 
      src="{{ 'hero-banner.jpg' | asset_url }}" 
      alt="{{ section.settings.heading | default: 'Ironivo Eagle Claw Gripper & Lever Belt' }}" 
      class="pro-hero-img"
      loading="eager"
    >
    <div class="pro-hero-overlay"></div>
  </div>

  <div class="pro-hero-container page-width">
    <div class="pro-hero-content pro-animate-fade-up">
      <div class="pro-hero-badge">
        <span class="pro-pulse-dot"></span>
        <span>{{ section.settings.badge_text | default: 'FLAGSHIP SERIES • EAGLE CLAW & LEVER BELT' }}</span>
      </div>

      <h1 class="pro-hero-title">
        {{ section.settings.heading | default: 'FORGE UNBREAKABLE' }} <span class="pro-text-gradient">{{ section.settings.heading_gradient | default: 'GRIP & CORE POWER' }}</span>
      </h1>

      <p class="pro-hero-subtitle">
        {{ section.settings.subheading | default: 'Engineered for athletes who demand maximum strength. Dominate your training with the 5-Finger Eagle Claw Gripper and Heavy-Duty 10mm Powerlifting Lever Belt.' }}
      </p>

      <div class="pro-hero-cta-group">
        <a href="#pro-bestsellers" class="pro-btn pro-btn--primary pro-btn--glow">
          <span>{{ section.settings.button_label | default: 'EXPLORE THE 2 ESSENTIALS' }} &rarr;</span>
        </a>

        <a href="#pro-features" class="pro-btn pro-btn--glass">
          <span>VIEW SPECIFICATIONS</span>
        </a>
      </div>

      <div class="pro-hero-stats">
        <div class="pro-stat-item">
          <span class="pro-stat-value">5-Finger</span>
          <span class="pro-stat-label">Eagle Claw Tech</span>
        </div>
        <div class="pro-stat-divider"></div>
        <div class="pro-stat-item">
          <span class="pro-stat-value">10mm</span>
          <span class="pro-stat-label">Steel Lever Belt</span>
        </div>
        <div class="pro-stat-divider"></div>
        <div class="pro-stat-item">
          <span class="pro-stat-value">30-Day</span>
          <span class="pro-stat-label">Risk-Free Trial</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FLAGSHIP SERIES • EAGLE CLAW & LEVER BELT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Part 1",
      "default": "FORGE UNBREAKABLE"
    },
    {
      "type": "text",
      "id": "heading_gradient",
      "label": "Heading Accent",
      "default": "GRIP & CORE POWER"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for athletes who demand maximum strength. Dominate your training with the 5-Finger Eagle Claw Gripper and Heavy-Duty 10mm Powerlifting Lever Belt."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE THE 2 ESSENTIALS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
