{% comment %}
  Features Showcase Section - Eagle Claw Gripper & Lever Belt
{% endcomment %}

<div id="pro-features" class="pro-showcase-section page-width">
  <!-- Feature 1: Eagle Claw Gripper -->
  <div class="pro-showcase-grid pro-animate-on-scroll">
    <div class="pro-showcase-visual">
      <div class="pro-card-3d">
        <img 
          src="{{ 'eagle-claw-gripper.jpg' | asset_url }}" 
          alt="Ironivo Eagle Claw 5-Finger Strengthener"
          class="pro-showcase-img"
          loading="lazy"
        >
        <div class="pro-tag-badge">5-FINGER EAGLE CLAW</div>
      </div>
    </div>

    <div class="pro-showcase-content">
      <div class="pro-section-tag">PRECISION RESISTANCE</div>
      <h2 class="pro-showcase-heading">{{ section.settings.feature_1_heading | default: 'Eagle Claw 5-Finger Spring Strengthener' }}</h2>
      <p class="pro-showcase-desc">
        {{ section.settings.feature_1_desc | default: 'Unlike generic grippers, the Eagle Claw features 5 independent spring-loaded finger pistons in an arched mechanical claw frame. Press all 5 fingertips inward to develop crushing pinch, claw, and finger extensor power.' }}
      </p>

      <ul class="pro-feature-list">
        <li>
          <span class="pro-check-icon">✓</span>
          <div>
            <strong>Independent 5-Finger Pistons</strong>
            <p>Isolate pinky, ring, and thumb weakness for balanced hand power.</p>
          </div>
        </li>
        <li>
          <span class="pro-check-icon">✓</span>
          <div>
            <strong>High-Tension Titanium Springs</strong>
            <p>Maintains consistent resistance without fading over thousands of reps.</p>
          </div>
        </li>
        <li>
          <span class="pro-check-icon">✓</span>
          <div>
            <strong>Textured Non-Slip Anodized Pads</strong>
            <p>Ergonomic fingertip contours for maximum grip security without pinching.</p>
          </div>
        </li>
      </ul>

      <div class="pro-showcase-action">
        <a href="#pro-bestsellers" class="pro-btn pro-btn--primary">
          <span>SHOP EAGLE CLAW &rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Feature 2: 10mm Powerlifting Lever Belt -->
  <div class="pro-showcase-grid pro-showcase-grid--reversed pro-animate-on-scroll" style="margin-top: 80px;">
    <div class="pro-showcase-content">
      <div class="pro-section-tag">MAXIMUM CORE BRACING</div>
      <h2 class="pro-showcase-heading">{{ section.settings.feature_2_heading | default: 'Heavy-Duty 10mm Powerlifting Lever Belt' }}</h2>
      <p class="pro-showcase-desc">
        {{ section.settings.feature_2_desc | default: 'Constructed from premium multi-layer genuine leather with a heavy-duty stainless steel quick-release lever. Delivers rigid 360-degree intra-abdominal pressure support for heavy squats, deadlifts, and bench presses.' }}
      </p>

      <div class="pro-metric-cards">
        <div class="pro-metric-box">
          <span class="pro-metric-number">10mm</span>
          <span class="pro-metric-text">Competition Grade Thickness</span>
        </div>
        <div class="pro-metric-box">
          <span class="pro-metric-number">1-Click</span>
          <span class="pro-metric-text">Quick-Release Steel Lever</span>
        </div>
      </div>

      <ul class="pro-feature-list">
        <li>
          <span class="pro-check-icon">✓</span>
          <div>
            <strong>Indestructible Stainless Steel Buckle</strong>
            <p>Instant lock and release in half a second between heavy lifting sets.</p>
          </div>
        </li>
        <li>
          <span class="pro-check-icon">✓</span>
          <div>
            <strong>Plush Crimson Suede Inner Lining</strong>
            <p>Prevents digging or bruising your ribs while maintaining non-slip support.</p>
          </div>
        </li>
      </ul>

      <div class="pro-showcase-action">
        <a href="#pro-bestsellers" class="pro-btn pro-btn--primary">
          <span>SHOP LEVER BELT &rarr;</span>
        </a>
      </div>
    </div>

    <div class="pro-showcase-visual">
      <div class="pro-card-3d">
        <img 
          src="{{ 'lever-belt.jpg' | asset_url }}" 
          alt="Ironivo 10mm Powerlifting Lever Belt"
          class="pro-showcase-img"
          loading="lazy"
        >
        <div class="pro-tag-badge">HEAVY DUTY 10MM LEATHER</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features Showcase",
  "tag": "section",
  "class": "section-features",
  "settings": [
    {
      "type": "text",
      "id": "feature_1_heading",
      "label": "Feature 1 Heading",
      "default": "Eagle Claw 5-Finger Spring Strengthener"
    },
    {
      "type": "textarea",
      "id": "feature_1_desc",
      "label": "Feature 1 Description",
      "default": "5 independent spring-loaded finger pistons in an arched mechanical claw frame."
    },
    {
      "type": "text",
      "id": "feature_2_heading",
      "label": "Feature 2 Heading",
      "default": "Heavy-Duty 10mm Powerlifting Lever Belt"
    },
    {
      "type": "textarea",
      "id": "feature_2_desc",
      "label": "Feature 2 Description",
      "default": "Premium genuine leather with a heavy-duty stainless steel quick-release lever."
    }
  ],
  "presets": [
    {
      "name": "Features Showcase"
    }
  ]
}
{% endschema %}
