{% comment %}
  Customer Testimonials & Verified Reviews Section
{% endcomment %}

<div class="pro-reviews-section page-width" style="padding: 80px 24px; background: #ffffff;">
  <div class="preview-section-header pro-animate-on-scroll">
    <div class="pro-section-tag">VERIFIED RESULTS</div>
    <h2 class="preview-section-title">LOVED BY 15,000+ ATHLETES</h2>
    <p class="preview-section-subtitle">Real feedback from climbers, powerlifters, and fitness enthusiasts.</p>
  </div>

  <div class="pro-reviews-grid pro-animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
    <!-- Review 1 -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; display: flex; flex-direction: column; gap: 14px;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <span style="color: #f59e0b; font-size: 1.6rem;">★★★★★</span>
        <span style="background: #ecfdf5; color: #10b981; font-size: 1.15rem; font-weight: 700; padding: 4px 10px; border-radius: 9999px;">Verified Buyer ✓</span>
      </div>
      <p style="font-size: 1.5rem; line-height: 1.6; color: #334155; margin: 0; font-style: italic;">
        "My deadlift grip and bouldering endurance jumped noticeably within 2 weeks. The individual finger springs make an enormous difference."
      </p>
      <div style="margin-top: auto; display: flex; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid #e2e8f0;">
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #111827; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.3rem;">MK</div>
        <div>
          <strong style="display: block; font-size: 1.4rem; color: #0f172a;">Marcus K.</strong>
          <span style="font-size: 1.2rem; color: #64748b;">Competitive Rock Climber • California</span>
        </div>
      </div>
    </div>

    <!-- Review 2 -->
