{% comment %}
  Pro About & Mission Section
{% endcomment %}

<div class="pro-about-section">
  <div class="pro-about-bg">
    <img 
      src="{{ 'about-banner.jpg' | asset_url }}" 
      alt="Ironivo Performance Labs"
      class="pro-about-img"
      loading="lazy"
    >
    <div class="pro-about-overlay"></div>
  </div>

  <div class="pro-about-container page-width">
    <div class="pro-about-box pro-animate-on-scroll">
      <div class="pro-section-tag">OUR MISSION</div>
      <h2 class="pro-about-title">ENGINEERED FOR THE UNRELENTING</h2>
      <p class="pro-about-text">
        At Ironivo, we believe physical capability starts with the hands. We obsess over biometric resistance curves, military-grade materials, and biomechanical ergonomics so you never miss a lift, drop a hold, or compromise your potential.
      </p>
      <div class="pro-about-stats">
        <div>
          <span class="pro-about-stat-num">100%</span>
          <span class="pro-about-stat-label">Satisfaction Guaranteed</span>
        </div>
        <div>
          <span class="pro-about-stat-num">50K+</span>
          <span class="pro-about-stat-label">Reps Tested Per Unit</span>
        </div>
        <div>
          <span class="pro-about-stat-num">24/7</span>
          <span class="pro-about-stat-label">Athlete Support</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "⚡ Pro About & Mission",
  "tag": "section",
  "class": "section-pro-about",
  "settings": [],
  "presets": [
    {
      "name": "⚡ Pro About & Mission"
    }
  ]
}
{% endschema %}
