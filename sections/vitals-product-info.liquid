/* pulsating-dot is pure CSS (no mask): animations don't run inside CSS mask images, so the dot and its
   expanding ping ring are drawn with pseudo-elements instead. Same timing as the Stock Scarcity dot. */
.PgI--pulsating-dot {
	position: relative;
	background-color: transparent;
	/* stylelint-disable-next-line property-no-vendor-prefix -- this asset ships raw (no autoprefixer pass), so Safari needs the prefix */
	-webkit-mask: none;
	mask: none;
}

/* Both pseudos take the full (integer-sized) icon box and shrink via transform: percentage insets
   produce fractional layout boxes whose rounding lands asymmetrically, and the ring's scale-up
   amplifies that offset. Transforms use float precision, keeping dot and ring exactly concentric. */
.PgI--pulsating-dot::before,
.PgI--pulsating-dot::after {
	content: '';
	position: absolute;
	inset: 0;
	transform: scale(0.55);
	border-radius: 50%;
	background-color: currentColor;
}

.PgI--pulsating-dot::after {
	animation: PgI-keyframes__pulse 2s linear infinite;
}

@keyframes PgI-keyframes__pulse {
	0% {
		opacity: 0.5;
		transform: scale(0.55);
	}

	100% {
		opacity: 0;
		transform: scale(1.375);
	}
}
{%- endstyle -%}
{% style %}#shopify-section-{{ section.id }}{display:flow-root}{% endstyle %}
{%- if section.settings.page_background_type == 'color' and section.settings.page_background_color != blank and section.settings.page_background_color != 'rgba(0,0,0,0)' -%}
<script>
  /* Page background override, part 2 (Horizon). Horizon has no color-scheme
     classes: every section paints a backing .section-background with
     background-color: var(--color-background) — one global :root var,
     default white — which tiles OVER the body painted above. Overriding
     that var repaints body AND every blank/transparent section's backing
     layer, while sections given an explicit colour keep theirs (they set
     the var on their own element, which beats an inherited :root value).
     Gated to the color format: Dawn declares --color-background as "R, G, B"
     (consumed inside rgb()), so overriding it with a hex would break Dawn —
     skip that format entirely; part 1 already covers Dawn's body. */
  (function () {
    try {
      var root = document.documentElement;
      var cur = getComputedStyle(root).getPropertyValue('--color-background').trim();
      if (cur && !/^[\d\s,]+$/.test(cur)) {
        // The scrollbar track reads --color-background too (Firefox) / shows
        // the body through a transparent track (WebKit), so the override
        // below would tint the scrollbar top-to-bottom. Snapshot the scroll
        // containers' original scrollbar-color first, then restore it after,
        // and expose the original page bg for the WebKit track rule — the
        // scrollbar stays the theme's neutral, not the product page's colour.
        var scrollers = [root];
        var pw = document.querySelector('.page-wrapper');
        if (pw) { scrollers.push(pw); }
        var savedSC = scrollers.map(function (el) { return getComputedStyle(el).getPropertyValue('scrollbar-color'); });
        root.style.setProperty('--color-background', '{{ section.settings.page_background_color }}');
        root.style.setProperty('--color-background-rgb', '{{ section.settings.page_background_color | color_extract: "red" }} {{ section.settings.page_background_color | color_extract: "green" }} {{ section.settings.page_background_color | color_extract: "blue" }}');
        root.style.setProperty('--vtls-scrollbar-bg', cur);
        scrollers.forEach(function (el, i) {
          if (savedSC[i] && savedSC[i] !== 'auto') { el.style.setProperty('scrollbar-color', savedSC[i]); }
        });
      }
    } catch (e) {}
  })();
</script>
{%- endif -%}

<vtls-product-info
  id="vtls-pi-{{ section.id }}"
  class="vtls-pi"
  data-section-id="{{ section.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-product-url="{{ product.url }}"
  data-product-id="{{ product.id }}"
  {% unless request.design_mode %}data-update-url{% endunless %}
>
  {%- if product == blank -%}
    {%- if request.design_mode -%}
      <div class="vtls-pi__inner" style="padding: 3rem 1.5rem; text-align: center; opacity: 0.7;">
        Vitals Product Information — add this section to a product template to see it with real product data.
      </div>
    {%- endif -%}
  {%- else -%}
  <div class="vtls-pi__inner">
    <div class="vtls-pi__grid">
      {%- comment -%}
        Theme blocks (blocks/_vtls-*.liquid) render here. Product media and the
        Details group each bring their own column root (.vtls-pi__media-col /
        .vtls-pi__info), so the grid layout is unchanged from the single-file
        versions. Private (underscored) block names keep them out of other
        sections' pickers in any host theme.
      {%- endcomment -%}
      {% content_for 'blocks' %}
    </div>
  </div>

  {%- comment -%}
    Current-variant payload for the Section Rendering API flow: on option
    change the JS re-fetches this section (?option_values=...&section_id=...)
    and reads this block from the response. The server resolves the variant
    and Liquid formats the prices, so the client carries no variant matrix —
    any catalog size works unchanged, and no inventory data leaks to the page
    (stock status is rendered server-side inside the inventory block only).
    Plan "cap" is pre-computed: present only when a strike-through should show.
  {%- endcomment -%}
  <script type="application/json" data-vtls-current>
    {
      "id": {% if current_variant %}{{ current_variant.id }}{% else %}null{% endif %},
      "matched": {% if product.selected_variant %}true{% else %}false{% endif %},
      "available": {% if current_variant.available %}true{% else %}false{% endif %},
      "price": {{ current_variant.price | money | strip_html | json }},
      "compare": {% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
      "featured_media_id": {% if current_variant.featured_media %}{{ current_variant.featured_media.id }}{% else %}null{% endif %},
      "qty_min": {{ current_variant.quantity_rule.min | default: 1 }},
      "qty_max": {% if current_variant.quantity_rule.max %}{{ current_variant.quantity_rule.max }}{% else %}null{% endif %},
      "qty_inc": {{ current_variant.quantity_rule.increment | default: 1 }}{% if current_variant.selling_plan_allocations.size > 0 %},
      "plans": {
        {%- for allocation in current_variant.selling_plan_allocations -%}
          "{{ allocation.selling_plan.id }}": { "price": {{ allocation.price | money | strip_html | json }}, "cap": {% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | strip_html | json }}{% elsif current_variant.price > allocation.price %}{{ current_variant.price | money | strip_html | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }{% endif %}
    }
  </script>

  {%- comment -%}
    Always on (CON-3349). Most OS 2.0 themes (Dawn and Horizon included)
    print their own Product entity, so the runtime removes ours again when
    another Product JSON-LD exists — one entity per page, no duplicates.
  {%- endcomment -%}
  <script type="application/ld+json" data-vtls-jsonld>{{ product | structured_data }}</script>
  {%- endif -%}
</vtls-product-info>

<script>
  (function () {
    'use strict';
    if (customElements.get('vtls-product-info')) return;

    class VtlsProductInfo extends HTMLElement {
      /* Hide unselected variant media (Horizon's rule, CON-3350): media
         attached to a variant stays visible only while it IS the selected
         variant's featured media; unattached media always shows, and a
         variant with no featured media shows everything. */
      applyVariantMediaVisibility(featuredMediaId) {
        if (!this.querySelector('[data-vtls-hide-variants]')) return;
        var featured = featuredMediaId ? String(featuredMediaId) : '';
        this.querySelectorAll('[data-vtls-attached]').forEach(function (el) {
          el.hidden = featured ? el.dataset.vtlsMediaId !== featured : false;
        });
        this.refreshThumbHints();
      }

      /* One Product entity per page: our JSON-LD is always rendered, but
         it bows out when the host theme already prints its own. */
      dedupeStructuredData() {
        var ours = document.querySelector('script[type="application/ld+json"][data-vtls-jsonld]');
        if (!ours) return;
        var scripts = document.querySelectorAll('script[type="application/ld+json"]:not([data-vtls-jsonld])');
        for (var i = 0; i < scripts.length; i++) {
          if (/"@type"\s*:\s*"Product"/.test(scripts[i].textContent || '')) {
            ours.remove();
            return;
          }
        }
      }

      connectedCallback() {
        this.current = this.readPayloadFrom(this);
        if (!this.current) return;
        // Theme editor: setting changes re-render granular subtrees, so a
        // fresh server-hidden picker can land without this element
        // reconnecting. Re-read state and rebind (bindPicker is idempotent
        // per node and re-reveals).
        if (window.Shopify && window.Shopify.designMode && !this.onEditorSectionLoad) {
          var self = this;
          this.onEditorSectionLoad = function (e) {
            if (e.detail && e.detail.sectionId && e.detail.sectionId !== self.dataset.sectionId) return;
            self.current = self.readPayloadFrom(self) || self.current;
            self.bindPicker();
            self.bindQty();
            self.bindThumbHint();
            self.bindPlans();
          };
          document.addEventListener('shopify:section:load', this.onEditorSectionLoad);
        }
        // On the initial render "matched" false only means the URL carried no
        // explicit selection — the fallback variant IS what the page shows
        // and submits, so it counts as matched. Only option_values refetches
        // (applyRender) treat false as "impossible combination".
        this.current.matched = true;
        this.fetchAbort = null;
        // Duplicate Buy buttons blocks repeat the canonical form id (the one
        // every outside control's form attribute targets). Re-id the extras
        // so the DOM stays valid; the first form keeps all runtime bindings.
        // Attribute API on purpose: these forms contain <input name="id">,
        // and HTMLFormElement's named-control getter shadows the id property.
        var forms = this.querySelectorAll('form.vtls-pi__form');
        for (var i = 1; i < forms.length; i++) {
          forms[i].setAttribute('id', forms[i].getAttribute('id') + '-' + (i + 1));
        }
        this.appliedOptionValueIds = this.selectedOptionValueIds();
        this.bindPicker();
        this.bindExternalVariantSync();
        this.bindQty();
        this.bindThumbs();
        this.bindThumbHint();
        this.bindMediaNav();
        this.bindZoom();
        this.bindForm();
        this.bindPlans();
        this.bindGiftCard();
        this.renderPlanPrices();
        this.ensureAtcPainted();
        this.dedupeStructuredData();
        this.applyVariantMediaVisibility(this.current && this.current.featured_media_id);
        // AFTER the visibility pass: bindMediaSwipe measures the row to place
        // the active slide, so every figure it can scroll past must already
        // be in its final shown/hidden state.
        this.bindMediaSwipe();
        this.warmInitialMedia();
        this.bindCartLinesUpdate();
      }

      disconnectedCallback() {
        if (this.onEditorSectionLoad) {
          document.removeEventListener('shopify:section:load', this.onEditorSectionLoad);
          this.onEditorSectionLoad = null;
        }
        // The theme editor swaps section HTML on edits, reconnecting the
        // element — drop the document/window-level listeners so swapped-out
        // instances don't keep reacting to cart events and clicks.
        if (this.onCartLinesUpdate) {
          document.removeEventListener('shopify:cart:lines-update', this.onCartLinesUpdate);
          this.onCartLinesUpdate = null;
        }
        if (this.onOwnAtcClickCapture) {
          window.removeEventListener('click', this.onOwnAtcClickCapture, true);
          this.onOwnAtcClickCapture = null;
        }
        clearTimeout(this.atcSuccessTimer);
        // A swipe settling after the swap would run against a detached
        // subtree, where every offset reads 0 and the "nearest slide" search
        // ties on the first figure — stealing .is-active from the real hero.
        clearTimeout(this.mediaSwipeSettleTimer);
        // The carousel breakpoint MediaQueryList and layout observer from
        // bindMediaSwipe hold this instance through their callbacks — same
        // editor-swap retention story as the listeners above.
        if (this.mediaSwipeMq && this.onMediaSwipeMqChange) {
          if (this.mediaSwipeMq.removeEventListener) this.mediaSwipeMq.removeEventListener('change', this.onMediaSwipeMqChange);
          else if (this.mediaSwipeMq.removeListener) this.mediaSwipeMq.removeListener(this.onMediaSwipeMqChange);
        }
        this.mediaSwipeMq = null;
        this.onMediaSwipeMqChange = null;
        if (this.mediaCarouselRo) {
          this.mediaCarouselRo.disconnect();
          this.mediaCarouselRo = null;
        }
        // Close + clean up the zoom lightbox synchronously (the dialog
        // 'close' event is queued async — too late for an editor swap):
        // restores the page scroll lock and drops the visibility observer.
        this.closeZoom();
      }

      /* Vitals offer widgets (Volume Discount, BOGO, bundles, popups)
         intercept the ATC click and run the add themselves, so this
         section's own add path never fires for them. Vitals announces those
         adds with the same standard `shopify:cart:lines-update` event the
         theme's components listen to (action/lines ride on the event
         object, not `detail`). Show the confirmation when an add includes
         the variant this section currently displays AND traces back to a
         recent click on OUR button — other add sources (sticky bar, offer
         popups) dispatch the same event for the same variant, and lighting
         this button for those reads as feedback in the wrong place. */
      bindCartLinesUpdate() {
        var self = this;
        // Recorded at WINDOW capture — the first stop in the capture chain.
        // Vitals' offer interception listens at DOCUMENT capture and stops
        // propagation for the adds it manages, so a capture listener on this
        // element (or on document, registered later) never hears exactly the
        // clicks this gate exists to record. Window capture always runs
        // before document capture, so nothing can suppress it.
        this.lastOwnAtcClickAt = 0;
        this.onOwnAtcClickCapture = function (event) {
          var atc = self.querySelector('[data-vtls-atc]');
          if (event.isTrusted && atc && event.target instanceof Element && atc.contains(event.target)) {
            self.lastOwnAtcClickAt = Date.now();
          }
        };
        window.addEventListener('click', this.onOwnAtcClickCapture, true);
        this.onCartLinesUpdate = function (event) {
          if (!event || event.action !== 'add' || !Array.isArray(event.lines)) return;
          // Generous window: an intercepted add resolves within a couple of
          // seconds; anything older than this did not come from our button.
          if (!self.lastOwnAtcClickAt || Date.now() - self.lastOwnAtcClickAt > 10000) return;
          var idInput = self.querySelector('[data-vtls-variant-id]');
          if (!idInput || !idInput.value) return;
          var variantId = String(idInput.value);
          for (var i = 0; i < event.lines.length; i++) {
            var line = event.lines[i];
            // merchandiseId is a gid ("gid://shopify/ProductVariant/123");
            // compare on the trailing numeric id.
            var merchandiseId = line && line.merchandiseId ? String(line.merchandiseId) : '';
            if (merchandiseId.split('/').pop() === variantId) {
              self.lastOwnAtcClickAt = 0;
              self.showAtcSuccess();
              return;
            }
          }
        };
        document.addEventListener('shopify:cart:lines-update', this.onCartLinesUpdate);
      }

      /* Self-heal an unpainted ATC. Two failure shapes, both observed only
         in Shopify's theme editor preview (the storefront paints fine):

         1. The theme's button custom properties RESOLVE (e.g. Horizon's
            --button-background-color computes to a solid color) but the
            fill rule that consumes them doesn't apply — the button falls
            back to the theme's base outline look. Detected by "declared
            fill disagrees with computed background"; repainted with the
            theme's own variables, so the healed button matches the theme
            exactly. Gated to design mode — the storefront never needs it.

         2. Background AND border both compute fully transparent (nothing
            painted at all) — apply our dark default via the --fallback
            class. An intentional outline button keeps a visible border, so
            it never matches.

         Runs a frame after (re)connect so the check reads settled styles;
         the editor swaps section HTML on edits, which reconnects the
         element and re-runs this. */
      ensureAtcPainted() {
        var self = this;
        requestAnimationFrame(function () {
          var atc = self.querySelector('[data-vtls-atc]');
          if (!atc) return;
          var style = getComputedStyle(atc);
          // A painted gradient/image already shows the configured background;
          // the `background` shorthand zeroes background-color, so the heal
          // below would misread it as "unpainted" and overwrite the gradient
          // with the theme's solid button var (renders black in the editor).
          if (style.backgroundImage && style.backgroundImage !== 'none') return;
          // getComputedStyle serializes colors with comma syntax.
          var isComputedTransparent = function (value) {
            return !value || value === 'transparent' || /^rgba\(\s*\d+,\s*\d+,\s*\d+,\s*0\)$/.test(value);
          };
          // Raw declared values (custom properties) keep author syntax; only
          // an explicit zero alpha counts as transparent. A false negative
          // just skips the heal — never repaints something intentional.
          var isDeclaredTransparent = function (value) {
            if (!value || value === 'transparent' || value === 'none') return true;
            return /[,\/]\s*0(\.0+)?%?\s*\)\s*$/.test(value);
          };
          var declaredBg =
            style.getPropertyValue('--button-background-color').trim() ||
            style.getPropertyValue('--color-primary-button-background').trim();
          var isDesignMode = Boolean(window.Shopify && window.Shopify.designMode);

          if (
            isDesignMode &&
            isComputedTransparent(style.backgroundColor) &&
            declaredBg &&
            !isDeclaredTransparent(declaredBg)
          ) {
            atc.style.setProperty('background', 'var(--button-background-color, var(--color-primary-button-background))');
            var declaredColor =
              style.getPropertyValue('--button-color').trim() ||
              style.getPropertyValue('--color-primary-button-text').trim();
            if (declaredColor) {
              atc.style.setProperty('color', 'var(--button-color, var(--color-primary-button-text))');
            }
          } else if (isComputedTransparent(style.backgroundColor) && isComputedTransparent(style.borderTopColor)) {
            atc.classList.add('vtls-pi__atc--fallback');
          }
        });
      }

      readPayloadFrom(scope) {
        var el = scope.querySelector('[data-vtls-current]');
        if (!el) return null;
        try { return JSON.parse(el.textContent); } catch (e) { return null; }
      }

      /* ---------- variant picker (Section Rendering API) ---------- */
      bindPicker() {
        var self = this;
        var picker = this.querySelector('[data-vtls-picker]');
        if (!picker) return;
        // The picker is server-rendered [hidden] (no-JS fallback shows the
        // native select instead) and revealed here. An attribute, not a
        // noscript <style>: the editor's morph parses sections inertly,
        // which materializes noscript children, and an adopted <style>
        // applies even inside the UA-hidden noscript — that hid the picker
        // after every editor setting change until a full refresh.
        picker.removeAttribute('hidden');
        if (picker.dataset.vtlsBound) return;
        picker.dataset.vtlsBound = '1';
        picker.addEventListener('change', function () { self.onOptionsChanged(); });
      }

      selectedOptionValueIds() {
        // Scoped to the FIRST picker: a duplicate Selectors/Variant picker
        // block would otherwise double every option value id and corrupt the
        // option_values query (bindPicker already binds the first one only).
        var ids = [];
        var picker = this.querySelector('[data-vtls-picker]');
        if (!picker) return ids;
        picker.querySelectorAll('[data-vtls-option-index]').forEach(function (el) {
          if (el.tagName === 'SELECT') {
            if (el.value) ids.push(el.value);
          } else {
            var checked = el.querySelector('input:checked');
            if (checked) ids.push(checked.value);
          }
        });
        return ids;
      }

      /* Put the picker back on a known-good selection (used when a variant
         fetch fails: the visible options must not drift from the rendered
         price/id state). No change events on the picker — this must not
         trigger a refetch. */
      restoreOptionSelection(ids) {
        // Hidden id inputs first (independent of the picker block being
        // present): an external widget sync writes them BEFORE our refetch
        // runs (see bindExternalVariantSync), so on failure they must roll
        // back to the still-rendered variant or a submit would add a variant
        // the page doesn't show. The change event re-syncs Shopify's payment
        // SDKs; dispatched only on a real rollback, and the external-sync
        // listener ignores it because the value equals this.current.id.
        var current = this.current || {};
        if (current.id != null) {
          this.querySelectorAll('[data-vtls-variant-id], [data-vtls-installment-id]').forEach(function (input) {
            if (String(input.value) !== String(current.id)) {
              input.value = current.id;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }
        var picker = this.querySelector('[data-vtls-picker]');
        if (!picker || !ids) return;
        picker.querySelectorAll('[data-vtls-option-index]').forEach(function (el) {
          if (el.tagName === 'SELECT') {
            for (var i = 0; i < el.options.length; i++) {
              if (ids.indexOf(el.options[i].value) !== -1) { el.value = el.options[i].value; break; }
            }
          } else {
            el.querySelectorAll('input').forEach(function (input) {
              if (ids.indexOf(input.value) !== -1) input.checked = true;
            });
          }
        });
      }

      /* Single source of truth for the buy controls: label + disabled state
         from the current payload. An unmatched option combination reads as
         "Unavailable" (the until-now unused data-text-unavailable) with the
         button disabled, so the server's fallback variant can never be added. */
      syncAtcState() {
        var payload = this.current || {};
        var unmatched = payload.matched === false;
        var atc = this.querySelector('[data-vtls-atc]');
        var atcText = this.querySelector('[data-vtls-atc-text]');
        if (atc) {
          atc.disabled = unmatched || !payload.available;
          if (atcText) {
            atcText.textContent = unmatched
              ? (atc.dataset.textUnavailable || atc.dataset.textSoldout)
              : (payload.available ? atc.dataset.textAdd : atc.dataset.textSoldout);
          }
        }
        var dynamic = this.querySelector('[data-vtls-dynamic]');
        if (dynamic) dynamic.classList.toggle('is-hidden', unmatched || !payload.available);
      }

      /* On option change, re-fetch THIS section with the selected option value
         ids (Dawn's pattern): the server resolves the variant, Liquid formats
         the prices and renders per-value availability. The client swaps the
         affected nodes and reads the payload - no variant matrix in the
         browser, so any catalog size works unchanged. */
      onOptionsChanged() {
        var ids = this.selectedOptionValueIds();
        if (!ids.length) return;
        this.refetchSection('option_values=' + ids.join(','));
      }

      /* Vitals app widgets that ship their own variant selectors (the Sticky
         Add to Cart bar, Volume Discount variant-locked tiers) push a
         selection into the host theme by writing the ATC form's hidden
         input[name="id"] and dispatching a bubbling change event (storefront
         updateVariantSelectorFromPage → handleInputChange). None of that
         util's theme-picker match paths (Dawn <variant-selects>, Horizon
         <variant-picker>, name="option1-…"/option-name inputs) recognize
         this section's option-value-id picker, so the hidden-input write is
         the only signal that always arrives. React by re-rendering from
         ?variant=<id> — the same Section Rendering flow as a picker change.
         Our own applyRender dispatches an identical event, but only after
         this.current already holds the new id, so the equality guard below
         filters it out (no self-triggering loop). */
      bindExternalVariantSync() {
        var self = this;
        if (this.externalVariantSyncBound) return;
        this.externalVariantSyncBound = true;
        this.addEventListener('change', function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          if (!target.matches('[data-vtls-variant-id], [data-vtls-installment-id]')) return;
          var id = String(target.value || '');
          if (!id || !self.current || String(self.current.id) === id) return;
          self.refetchSection('variant=' + id);
        });
      }

      /* Shared Section Rendering refetch: `option_values=…` from the picker,
         `variant=…` from an external widget sync. Aborts any in-flight
         request, swaps the returned nodes via applyRender, and restores the
         last rendered state on failure. */
      refetchSection(query) {
        var self = this;
        if (this.fetchAbort) this.fetchAbort.abort();
        var controller = typeof AbortController === 'function' ? new AbortController() : null;
        this.fetchAbort = controller;
        var url =
          this.dataset.productUrl +
          '?' + query +
          '&section_id=' + this.dataset.sectionId;
        this.classList.add('is-switching');
        // The hidden id still holds the PREVIOUS variant until the response
        // lands — block adds meanwhile so a quick click can't buy the old
        // variant under the new selection. applyRender/syncAtcState re-enable.
        var atc = this.querySelector('[data-vtls-atc]');
        if (atc) atc.disabled = true;
        fetch(url, controller ? { signal: controller.signal } : undefined)
          .then(function (response) {
            // A non-OK render (404/500/challenge page) has no payload; treat
            // it as a failed switch so the catch below restores the UI instead
            // of leaving the ATC disabled forever.
            if (!response.ok) throw new Error('section render HTTP ' + response.status);
            return response.text();
          })
          .then(function (html) {
            if (controller && controller.signal.aborted) return;
            var doc = new DOMParser().parseFromString(html, 'text/html');
            self.applyRender(doc);
          })
          .catch(function () {
            // Aborted: a newer option change owns the UI now — do nothing.
            if (controller && controller.signal.aborted) return;
            // Network failure: revert the picker to the last rendered state
            // so the visible options match the price/id still on screen.
            self.restoreOptionSelection(self.appliedOptionValueIds);
            self.syncAtcState();
          })
          .finally(function () {
            // Only the owning fetch clears the loading state — a superseded
            // request must not flash settled UI while the newer one runs.
            if (self.fetchAbort === controller) {
              self.classList.remove('is-switching');
              self.fetchAbort = null;
            }
          });
      }

      applyRender(doc) {
        var self = this;
        var payload = this.readPayloadFrom(doc);
        if (!payload) {
          // 200 but not our section markup (challenge/interstitial page):
          // same recovery as a network failure - revert the picker and let
          // the still-current payload decide the ATC state (never stuck).
          this.restoreOptionSelection(this.appliedOptionValueIds);
          this.syncAtcState();
          return;
        }
        this.current = payload;
        // "matched" false means the requested option_values hit no real
        // variant: the server rendered its first-available FALLBACK. Nothing
        // below may present that fallback as the shopper's selection.
        var unmatched = payload.matched === false;

        // Vitals widgets may have hidden the picker externally: Volume
        // Discount variant-locked tiers hide the ProductVariants anchor
        // (this picker carries .product-form__variants) — jQuery .hide()
        // writes an inline display:none; some paths set [hidden] instead.
        // The wholesale swap below would resurrect it: the fresh server
        // node has neither, and bindPicker strips its server-rendered
        // [hidden]. Capture the external state and re-apply after the swap
        // — with the SAME mechanism (style attr vs hidden attr), so the
        // widget's own un-hide path still finds what it originally set.
        var oldPicker = this.querySelector('[data-vtls-picker]');
        // bindPicker removed the server [hidden] at bind time, so its
        // presence now can only mean an external actor re-hid the picker.
        var pickerHiddenAttr = !!oldPicker && oldPicker.hasAttribute('hidden');
        var pickerInlineStyle = oldPicker ? oldPicker.getAttribute('style') : null;

        // Server-rendered nodes swapped wholesale: picker (selection +
        // availability states), price row, SKU, inventory.
        ['[data-vtls-picker]', '[data-vtls-price-row]', '[data-vtls-sku]', '[data-vtls-inventory]', '[data-vtls-pickup]'].forEach(
          function (sel) {
            var mine = self.querySelector(sel);
            var theirs = doc.querySelector(sel);
            if (mine && theirs) mine.replaceWith(theirs);
          }
        );
        this.bindPicker(); // the picker node was replaced; rebind its listener
        var newPicker = this.querySelector('[data-vtls-picker]');
        if (newPicker) {
          // Our own code never writes inline styles on the picker (the
          // switching dim is a class-scoped rule), so any captured inline
          // style is external — carry it verbatim.
          if (pickerInlineStyle != null) newPicker.setAttribute('style', pickerInlineStyle);
          if (pickerHiddenAttr) newPicker.setAttribute('hidden', '');
        }
        this.appliedOptionValueIds = this.selectedOptionValueIds();

        // Fallback-variant data must not show for an impossible combination:
        // hide the swapped price/SKU/stock nodes (fresh swaps restore them on
        // the next matched render) and let syncAtcState flip the button to
        // the disabled "Unavailable" state.
        var priceRow = this.querySelector('[data-vtls-price-row]');
        if (priceRow) priceRow.hidden = unmatched;
        if (unmatched) {
          var skuEl = this.querySelector('[data-vtls-sku]');
          if (skuEl) skuEl.hidden = true;
          var invEl = this.querySelector('[data-vtls-inventory]');
          if (invEl) invEl.hidden = true;
        }

        this.syncAtcState();
        if (unmatched) return;

        // Dynamic checkout and the installments banner hydrate off these
        // hidden inputs; Shopify's SDKs need the change event to notice the
        // new variant (assignment alone leaves Buy now / Shop Pay stale).
        var idInput = this.querySelector('[data-vtls-variant-id]');
        if (idInput) {
          idInput.value = payload.id;
          idInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        var installmentId = this.querySelector('[data-vtls-installment-id]');
        if (installmentId) {
          installmentId.value = payload.id;
          installmentId.dispatchEvent(new Event('change', { bubbles: true }));
        }

        this.syncPlanInput();
        this.applyPlanPricing();
        this.renderPlanPrices();

        var qtyInput = this.querySelector('[data-vtls-qty-input]');
        if (qtyInput) {
          var qtyMin = payload.qty_min || 1;
          qtyInput.min = qtyMin;
          qtyInput.step = payload.qty_inc || 1;
          if (payload.qty_max) qtyInput.max = payload.qty_max; else qtyInput.removeAttribute('max');
          var qtyValue = Number(qtyInput.value) || qtyMin;
          if (qtyValue < qtyMin) qtyValue = qtyMin;
          if (payload.qty_max && qtyValue > payload.qty_max) qtyValue = payload.qty_max;
          qtyInput.value = qtyValue;
          this.syncQtyMirror();
        }

        this.applyVariantMediaVisibility(payload.featured_media_id);
        // instant: a variant switch repositions the mobile carousel directly
        // on the new hero (Horizon does the same) — smooth-scrolling across
        // slides whose row just re-flowed from the hidden-media flip looks
        // like a glitch, not a transition.
        if (payload.featured_media_id) this.activateMedia(payload.featured_media_id, true);

        if (this.hasAttribute('data-update-url')) {
          try {
            var url = new URL(window.location.href);
            url.searchParams.set('variant', payload.id);
            url.searchParams.delete('option_values');
            window.history.replaceState({}, '', url.toString());
          } catch (e) { /* noop */ }
        }
      }

      /* ---------- selling plans ---------- */
      bindPlans() {
        var self = this;
        // Scripted plan rows ship [hidden] (the noscript fallback is the
        // no-JS UI - variant-picker pattern since VERSION-39, so the theme
        // editor's inert re-parse cannot flash unbound UI). Reveal them here;
        // per-radio flags keep editor rebinds from double-binding.
        this.querySelectorAll('.vtls-pi__plan--js[hidden]').forEach(function (row) {
          row.hidden = false;
        });
        this.querySelectorAll('[data-vtls-plan-radio]').forEach(function (radio) {
          if (radio.dataset.vtlsBound) { return; }
          radio.dataset.vtlsBound = '1';
          radio.addEventListener('change', function () {
            self.querySelectorAll('.vtls-pi__plan').forEach(function (row) {
              row.classList.toggle('is-selected', row.querySelector('input').checked);
            });
            self.syncPlanInput();
            self.applyPlanPricing();
          });
        });
        // requires_selling_plan ships the first plan pre-checked, so the
        // submitted input and the price row must sync at bind time too —
        // not only on the first change event. Both calls are idempotent.
        if (this.querySelector('[data-vtls-plan-radio]:checked')) {
          this.syncPlanInput();
          this.applyPlanPricing();
        }
      }

      /* ---------- gift-card recipient form (Horizon parity) ----------
         "Send as a gift" enables the recipient inputs; every recipient field
         renders disabled, so it submits ONLY on opt-in (disabled inputs are
         excluded from FormData and the payment button alike). The hidden
         __shopify_send_gift_card_to_recipient=on flag is what tells Shopify to
         email the card; __shopify_offset carries the shopper timezone for the
         Send-on date. Both toggle enabled with the fields. */
      bindGiftCard() {
        var wrap = this.querySelector('[data-vtls-gift-card]');
        if (!wrap) return;
        var fields = wrap.querySelector('[data-vtls-gc-fields]');
        var inputs = wrap.querySelectorAll('[data-vtls-gc-input]');
        var flag = wrap.querySelector('[data-vtls-gc-flag]');
        var offset = wrap.querySelector('[data-vtls-gc-offset]');
        var email = wrap.querySelector('[data-vtls-gc-email]');
        var date = wrap.querySelector('[data-vtls-gc-date]');
        var self = this;
        function setMode(isGift) {
          if (fields) fields.hidden = !isGift;
          inputs.forEach(function (el) {
            el.disabled = !isGift;
            if (!isGift) el.value = '';
          });
          if (email) {
            if (isGift) email.setAttribute('required', '');
            else email.removeAttribute('required');
          }
          if (flag) flag.disabled = !isGift;
          if (offset) {
            offset.disabled = !isGift;
            offset.value = isGift ? String(new Date().getTimezoneOffset()) : '';
          }
          if (date) {
            if (isGift) {
              var today = new Date();
              var max = new Date();
              max.setDate(max.getDate() + 90);
              date.min = self.toDateInput(today);
              date.max = self.toDateInput(max);
            } else {
              date.removeAttribute('min');
              date.removeAttribute('max');
            }
          }
        }
        wrap.querySelectorAll('[data-vtls-gc-mode]').forEach(function (radio) {
          radio.addEventListener('change', function () {
            setMode(radio.checked && radio.value === 'recipient');
          });
        });
        // Re-validate the recipient email as the shopper types so the error
        // clears the moment the address becomes valid (matching the theme's
        // default gift-card form, which validates on input).
        if (email) {
          email.addEventListener('input', function () { self.validateGcEmail(); });
        }
      }

      /* Recipient-email validity, kept live via the input listener above and
         checked again on submit. type=email is lenient (it accepts "foo@bar"),
         so require a dotted domain; the custom message is only applied when the
         native check already passes, so the browser's "include an '@'" / "fill
         out this field" messages survive for the no-@ / empty cases. */
      validateGcEmail() {
        var email = this.querySelector('[data-vtls-gc-email]');
        if (!email) return true;
        email.setCustomValidity('');
        if (email.disabled) return true;
        var val = email.value.trim();
        if (val && email.validity.valid && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val)) {
          email.setCustomValidity('Please enter a valid email address.');
        }
        return email.validity.valid;
      }

      toDateInput(d) {
        var m = ('0' + (d.getMonth() + 1)).slice(-2);
        var day = ('0' + d.getDate()).slice(-2);
        return d.getFullYear() + '-' + m + '-' + day;
      }

      selectedPlanId() {
        var checked = this.querySelector('[data-vtls-plan-radio]:checked');
        return checked ? checked.value : '';
      }

      /* Keep the submitted selling_plan in sync with the displayed pricing:
         when the selected plan has no allocation for the current variant we
         show the one-time price, so the form must not send a stale plan id. */
      syncPlanInput() {
        var planInput = this.querySelector('[data-vtls-selling-plan]');
        if (!planInput) return;
        var planId = this.selectedPlanId();
        var hasPlan = Boolean(planId && this.current && this.current.plans && this.current.plans[planId]);
        planInput.value = hasPlan ? planId : '';
        planInput.disabled = !hasPlan;
      }

      /* The server renders the one-time price; the payload carries each plan's
         Liquid-formatted price, so no client-side money math is needed. `cap`
         is present only when a strike-through should show. */
      applyPlanPricing() {
        var payload = this.current;
        if (!payload) return;
        var planId = this.selectedPlanId();
        var plan = planId && payload.plans ? payload.plans[planId] : null;
        var price = plan ? plan.price : payload.price;
        var compare = plan ? plan.cap : payload.compare;
        var priceEl = this.querySelector('[data-vtls-price]');
        if (priceEl) priceEl.textContent = price || '';
        var compareEl = this.querySelector('[data-vtls-compare]');
        var saleBadge = this.querySelector('[data-vtls-sale-badge]');
        var onSale = Boolean(compare);
        if (compareEl) {
          compareEl.hidden = !onSale;
          if (onSale) compareEl.textContent = compare;
        }
        if (saleBadge) saleBadge.hidden = !onSale;
      }

      /* Show each plan's price for the current variant next to its label. */
      renderPlanPrices() {
        var payload = this.current || {};
        this.querySelectorAll('[data-vtls-plan-price]').forEach(function (el) {
          var planId = el.dataset.vtlsPlanPrice;
          var value = planId
            ? (payload.plans && payload.plans[planId] ? payload.plans[planId].price : '')
            : (payload.price || '');
          el.textContent = value || '';
        });
      }

      /* ---------- media ---------- */
      bindThumbs() {
        var self = this;
        this.querySelectorAll('[data-vtls-thumb]').forEach(function (thumb) {
          thumb.addEventListener('click', function () {
            self.activateMedia(thumb.dataset.vtlsThumb);
          });
          // Hover signals intent: warm the figure so the click cross-fades
          // into an already-painted image.
          thumb.addEventListener('pointerenter', function () {
            self.warmMediaItem(self.querySelector('.vtls-pi__media-item[data-vtls-media-id="' + thumb.dataset.vtlsThumb + '"]'));
          });
        });
      }

      bindThumbHint() {
        var self = this;
        // Horizon's scroll-hint: a scroll-position-aware mask fades whichever
        // edge still has hidden thumbnails and clears when they all fit. Axis-
        // aware so it covers the main row (horizontal), the zoom/fullscreen
        // rail on mobile (horizontal) AND the zoom rail on desktop (vertical
        // column). No overflow on an axis -> that axis stays crisp; neither ->
        // mask cleared entirely.
        this.thumbHintUpdates = this.thumbHintUpdates || [];
        ['[data-vtls-thumbs]', '[data-vtls-zoom-thumbs]'].forEach(function (sel) {
          var el = self.querySelector(sel);
          if (!el || el.dataset.vtlsHintBound) { return; }
          el.dataset.vtlsHintBound = '1';
          var update = function () {
            var sw = el.scrollWidth, cw = el.clientWidth, sh = el.scrollHeight, ch = el.clientHeight;
            var horizontal = sw > cw + 1;
            var vertical = sh > ch + 1;
            // is-fit centers the main row under the photo on desktop (CSS is
            // scoped there); centering is safe exactly because there is no
            // overflow to clip. Inert on the zoom rail (no CSS targets it).
            el.classList.toggle('is-fit', !horizontal && !vertical);
            if (!horizontal && !vertical) { el.style.maskImage = ''; el.style.webkitMaskImage = ''; return; }
            var p = horizontal ? el.scrollLeft / (sw - cw) : el.scrollTop / (sh - ch);
            var mask = 'linear-gradient(' + (horizontal ? 'to right' : 'to bottom') +
              ', transparent ' + (p > 0 ? 1 : 0) + '%, black ' + (p < 0.1 ? p * 100 : 10) +
              '%, black ' + (p > 0.9 ? p * 100 : 90) + '%, transparent 100%)';
            el.style.maskImage = mask;
            el.style.webkitMaskImage = mask;
          };
          var ticking = false;
          el.addEventListener('scroll', function () {
            if (ticking) { return; }
            ticking = true;
            requestAnimationFrame(function () { ticking = false; update(); });
          });
          if (window.ResizeObserver) {
            new ResizeObserver(function () { update(); }).observe(el);
          }
          self.thumbHintUpdates.push(update);
          update();
        });
      }

      /* Variant switches hide/show thumbs without resizing the rail's box,
         so ResizeObserver misses them — re-run the hint/fit measurements
         explicitly after visibility changes. */
      refreshThumbHints() {
        (this.thumbHintUpdates || []).forEach(function (fn) { fn(); });
      }

      /* Horizon-style gallery arrows: step through the currently VISIBLE
         figures (variant-hidden ones are skipped) and wrap at both ends. */
      bindMediaNav() {
        var self = this;
        var prev = this.querySelector('[data-vtls-media-prev]');
        var next = this.querySelector('[data-vtls-media-next]');
        if (!prev && !next) return;
        var targetFor = function (dir) {
          var items = [];
          self.querySelectorAll('.vtls-pi__media-item[data-vtls-media-id]').forEach(function (item) {
            if (!item.hidden) items.push(item);
          });
          if (items.length < 2) return null;
          var idx = 0;
          items.forEach(function (item, i) {
            if (item.classList.contains('is-active')) idx = i;
          });
          return items[(idx + dir + items.length) % items.length];
        };
        var bind = function (btn, dir) {
          if (!btn) return;
          btn.addEventListener('click', function () {
            var target = targetFor(dir);
            if (target) self.activateMedia(target.dataset.vtlsMediaId);
          });
          // Hover signals intent: start the fetch before the click lands.
          btn.addEventListener('pointerenter', function () {
            self.warmMediaItem(targetFor(dir));
          });
        };
        bind(prev, -1);
        bind(next, 1);
      }

      /* ---------- mobile swipe carousel (Horizon slideshow pattern) ----------
         Below 750px the media list is a native scroll-snap carousel (see the
         gallery CSS) — swiping IS plain touch scrolling, no gesture code.
         These helpers keep .is-active + the thumb rail in sync with whichever
         slide the scroll settles on, and give arrows / thumbs / variant
         changes a scroll path into the same scroller. */
      isMediaCarousel() {
        return window.matchMedia && window.matchMedia('(max-width: 749px)').matches;
      }

      /* The visible slide whose center sits nearest the scroller's viewport
         center — the one the snap has (or will have) settled on. */
      currentCarouselSlide() {
        var list = this.querySelector('[data-vtls-media-list]');
        if (!list) return null;
        var mid = list.scrollLeft + list.clientWidth / 2;
        var best = null;
        var bestDist = Infinity;
        this.querySelectorAll('.vtls-pi__media-item[data-vtls-media-id]').forEach(function (item) {
          if (item.hidden) return;
          var dist = Math.abs(item.offsetLeft + item.offsetWidth / 2 - mid);
          if (dist < bestDist) { bestDist = dist; best = item; }
        });
        return best;
      }

      bindMediaSwipe() {
        var self = this;
        var list = this.querySelector('[data-vtls-media-list]');
        if (!list) return;
        // The scroll listener rides the element-local dataset flag because it
        // is bound to the list node itself: a DOM move carries both along, so
        // re-adding would double-fire. The mq listener and observer below ride
        // instance fields that disconnectedCallback nulls, so those DO get
        // re-created. (Both guards only matter for a move/reconnect — a theme
        // editor block re-render replaces the list with a fresh node.)
        if (!list.dataset.vtlsSwipeBound) {
          list.dataset.vtlsSwipeBound = '1';
          // Settle-debounced sync: mid-swipe (and mid smooth-scroll from an
          // arrow/thumb click) the classes stay put; whichever slide the snap
          // lands on becomes active. Programmatic scrolls feed through here
          // too and simply find their target already active. The timer is
          // instance-held so disconnectedCallback can kill it: on a detached
          // subtree every offset reads 0, so a late settle would hand
          // .is-active to the first figure and discard the real one.
          list.addEventListener('scroll', function () {
            if (!self.isMediaCarousel()) return;
            clearTimeout(self.mediaSwipeSettleTimer);
            self.mediaSwipeSettleTimer = setTimeout(function () {
              var slide = self.currentCarouselSlide();
              if (!slide || slide.classList.contains('is-active')) return;
              // A swipe supersedes any in-flight decode-gated switch.
              self.mediaSwitchToken = (self.mediaSwitchToken || 0) + 1;
              self.querySelectorAll('.vtls-pi__media-item.is-active').forEach(function (el) {
                el.classList.remove('is-active');
              });
              slide.classList.add('is-active');
              self.syncThumbActive(slide.dataset.vtlsMediaId, !!self.querySelector('[data-vtls-thumbs]'), null);
              self.warmAdjacentMedia(slide);
            }, 90);
          });
        }
        // Crossing into mobile mid-session (rotation / editor resize): enable
        // the scroller and land on the active slide in this same handler.
        // Held on the instance and removed in disconnectedCallback: the
        // MediaQueryList outlives theme-editor section swaps, so an
        // unremoved listener would keep retaining swapped-out instances.
        // matchMedia() hands back a NEW MediaQueryList per call, so the exact
        // instance has to be kept to remove from.
        if (window.matchMedia && !this.onMediaSwipeMqChange) {
          this.mediaSwipeMq = window.matchMedia('(max-width: 749px)');
          this.onMediaSwipeMqChange = function (e) {
            if (e.matches) self.enableMediaCarousel();
          };
          if (this.mediaSwipeMq.addEventListener) this.mediaSwipeMq.addEventListener('change', this.onMediaSwipeMqChange);
          else if (this.mediaSwipeMq.addListener) this.mediaSwipeMq.addListener(this.onMediaSwipeMqChange);
        }
        // Turn the pre-JS clipped row into the real scroller. Synchronous on
        // purpose — NOT in a rAF: see enableMediaCarousel.
        if (!this.enableMediaCarousel() && window.ResizeObserver && !this.mediaCarouselRo) {
          // Only reachable with no layout to measure (a display:none ancestor
          // — quick view, collapsed tab, drawer). The pre-JS mode is already
          // showing the correct hero, so waiting costs nothing; without this
          // the row would stay un-flipped for good, since a matchMedia change
          // may never come. Local `ro` so a stale callback from an earlier
          // bind cycle can only ever disconnect its OWN observer.
          var ro = new ResizeObserver(function () {
            if (!self.enableMediaCarousel()) return;
            ro.disconnect();
            if (self.mediaCarouselRo === ro) self.mediaCarouselRo = null;
          });
          this.mediaCarouselRo = ro;
          ro.observe(list);
        }
      }

      /* Flip the mobile gallery from its pre-JS state (all slides in flow,
         clipped to one slot, active figure hoisted into it by CSS order:-1)
         into a real scroll-snap carousel. Returns true once flipped.

         The class add and the scroll MUST stay in one synchronous block: the
         class restores natural order, which moves the active figure out of
         slot 0, and only the scroll puts it back under the viewport. A
         rendering opportunity between the two would paint the wrong slide —
         which is the whole bug this replaced. Do not "tidy" the scroll into
         a rAF or a microtask. */
      enableMediaCarousel() {
        var list = this.querySelector('[data-vtls-media-list]');
        if (!list || !this.isMediaCarousel()) return false;
        // No box to measure yet: stay in the pre-JS mode, which is correct.
        if (!list.clientWidth) return false;
        // Both steps below are idempotent, and re-running them on every entry
        // into carousel mode is REQUIRED, not merely harmless. The class is
        // never cleared on the way out (its rules are inert above 750px), but
        // the scroll offset does not survive the trip: while the row is not a
        // scroller the browser drops/clamps scrollLeft, and .is-active can
        // move meanwhile through the desktop cross-fade. Returning early here
        // because the class was already present left the row parked on the
        // pre-desktop slide with the thumb rail pointing at the real one.
        list.classList.add('is-carousel');
        this.scrollCarouselToActive();
        return true;
      }

      scrollCarouselToActive() {
        var active = this.querySelector('.vtls-pi__media-item.is-active[data-vtls-media-id]');
        if (active) this.scrollCarouselTo(active, true);
      }

      /* Center a slide in the scroller; instant skips the smooth glide
         (initial positioning + variant switches). No-op outside carousel
         mode or when already aligned. */
      scrollCarouselTo(slide, instant) {
        if (!slide || !this.isMediaCarousel()) return;
        var list = this.querySelector('[data-vtls-media-list]');
        if (!list || list.scrollWidth <= list.clientWidth + 1) return;
        var dest = slide.offsetLeft - (list.clientWidth - slide.offsetWidth) / 2;
        dest = Math.max(0, Math.min(dest, list.scrollWidth - list.clientWidth));
        if (Math.abs(list.scrollLeft - dest) < 1) return;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (typeof list.scrollTo === 'function') {
          list.scrollTo({ left: dest, behavior: instant || reduce ? 'auto' : 'smooth' });
        } else {
          list.scrollLeft = dest;
        }
      }

      activateMedia(mediaId, instant) {
        mediaId = String(mediaId);
        var self = this;
        // Gallery figures ONLY: with "Hide unselected variant media" on, the
        // attached thumbs and zoom-dialog items carry data-vtls-media-id too
        // (for applyVariantMediaVisibility) — an unscoped query made the LAST
        // match the target and stole is-active from the figure, blanking the
        // main gallery.
        var items = this.querySelectorAll('.vtls-pi__media-item[data-vtls-media-id]');
        var target = null, current = null;
        items.forEach(function (item) {
          if (item.dataset.vtlsMediaId === mediaId) target = item;
          if (item.classList.contains('is-active')) current = item;
        });
        if (!target) return;
        var hasThumbs = !!this.querySelector('[data-vtls-thumbs]');
        if (target === current) {
          this.syncThumbActive(mediaId, hasThumbs, target);
          // Re-align the mobile carousel even on a no-op switch: a variant
          // click can land while the user has swiped partway off the slide.
          this.scrollCarouselTo(target, instant);
          return;
        }
        // Supersede overlapping switches (rapid arrows / quick variant clicks):
        // a slower decode from an earlier click is dropped once a newer click wins.
        var token = (this.mediaSwitchToken = (this.mediaSwitchToken || 0) + 1);
        if (this.isMediaCarousel()) {
          // Carousel mode (mobile): the target is a real visible box in the
          // scroll row — no decode gating or cross-fade; mark it active and
          // scroll it into its snap position. A still-loading image paints
          // progressively like any native carousel (the warming sweep has
          // usually finished it already).
          if (current) current.classList.remove('is-active');
          target.classList.add('is-active');
          this.syncThumbActive(mediaId, hasThumbs, null);
          this.warmAdjacentMedia(target);
          this.scrollCarouselTo(target, instant);
          return;
        }
        var reveal = function () {
          if (self.mediaSwitchToken !== token) return;
          self.crossFadeMedia(current, target);
          self.syncThumbActive(mediaId, hasThumbs, target);
          self.warmAdjacentMedia(target);
        };
        // Decode the incoming image BEFORE revealing it, so it fades in fully
        // painted; the previous image stays visible until then (never a blank
        // box).
        var img = target.querySelector('img');
        var loaded = img && img.complete && img.naturalWidth > 0;
        if (loaded && typeof img.decode === 'function') {
          // Already loaded (the warming sweep's normal outcome): decode is
          // instant, so the incoming cross-fades in fully painted.
          img.decode().then(reveal, reveal);
        } else if (img && !img.complete) {
          // Click beat the background warming. The figure is display:none, so
          // its lazy <img> never started loading and decode() alone would HANG
          // FOREVER — flip the real img to eager (eager fetches ignore
          // display:none) and gate the reveal on ITS decode, so even a first
          // visit cross-fades fully painted instead of swapping to a blank
          // box. A timeout guards a slow/broken load so a switch never stalls.
          var settled = false;
          var go = function () { if (!settled) { settled = true; reveal(); } };
          img.loading = 'eager';
          if (typeof img.decode === 'function') {
            img.decode().then(go, go);
          } else {
            img.addEventListener('load', go);
            img.addEventListener('error', go);
          }
          setTimeout(go, 1200);
        } else {
          // No <img> (video/model) or a failed image: nothing to wait for.
          reveal();
        }
      }

      crossFadeMedia(current, target) {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.querySelectorAll('.vtls-pi__media-item.is-leaving').forEach(function (el) {
          el.classList.remove('is-leaving', 'is-fading');
        });
        // Only cross-fade when the incoming is actually painted; otherwise do an
        // instant swap so we never dissolve the old image into a blank box.
        var img = target.querySelector('img');
        var ready = !img || (img.complete && img.naturalWidth > 0);
        target.classList.add('is-active');
        if (!current || current === target) return;
        current.classList.remove('is-active');
        if (reduce || !ready) return;
        current.classList.add('is-leaving');
        void current.offsetWidth; // reflow so the opacity change transitions
        current.classList.add('is-fading');
        var done = function () {
          current.classList.remove('is-leaving', 'is-fading');
          current.removeEventListener('transitionend', done);
        };
        current.addEventListener('transitionend', done);
        setTimeout(done, 400); // safety net if transitionend is missed
      }

      syncThumbActive(mediaId, hasThumbs, target) {
        if (hasThumbs) {
          var active = null;
          this.querySelectorAll('[data-vtls-thumb]').forEach(function (thumb) {
            var on = thumb.dataset.vtlsThumb === mediaId;
            thumb.classList.toggle('is-active', on);
            if (on) active = thumb;
          });
          if (active) this.scrollThumbIntoView(active);
        } else if (target) {
          target.scrollIntoView({ block: 'nearest' });
        }
      }

      /* Keep the active thumbnail visible in the mobile horizontal carousel:
         when arrows / variant change move to an off-screen thumb, scroll the
         rail so it centers into view. No-op when the rail doesn't scroll
         (desktop wrap) or the thumb already fits fully, so it never jumps
         needlessly. The programmatic scroll feeds bindThumbHint's edge-fade
         mask through the same scroll event. */
      scrollThumbIntoView(thumb) {
        var rail = this.querySelector('[data-vtls-thumbs]');
        if (!rail || !thumb) return;
        if (rail.scrollWidth <= rail.clientWidth + 1) return;
        var railRect = rail.getBoundingClientRect();
        var thumbRect = thumb.getBoundingClientRect();
        if (thumbRect.left >= railRect.left && thumbRect.right <= railRect.right) return;
        var delta = (thumbRect.left - railRect.left) - (rail.clientWidth - thumbRect.width) / 2;
        var dest = Math.max(0, Math.min(rail.scrollLeft + delta, rail.scrollWidth - rail.clientWidth));
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (typeof rail.scrollTo === 'function') {
          rail.scrollTo({ left: dest, behavior: reduce ? 'auto' : 'smooth' });
        } else {
          rail.scrollLeft = dest;
        }
      }

      /* Force-load one figure's image even while its figure is display:none.
         A lazy <img> in a display:none figure NEVER starts loading (no box ->
         no intersection), and decode() on it just hangs — so warming flips it
         to eager (eager fetches ignore layout; Horizon's gallery media is
         eager for the same reason) and pre-decodes once loaded. `done`
         (optional) fires when the image settles either way, so the initial
         sweep can load one image at a time. */
      warmMediaItem(item, done) {
        var settle = function () {
          if (done) { var d = done; done = null; d(); }
        };
        var img = item && item.querySelector('img');
        if (!img) { settle(); return; }
        if (img.complete) {
          // Finished (or failed — nothing more to fetch): just pre-rasterize.
          if (img.naturalWidth > 0 && typeof img.decode === 'function') img.decode().catch(function () {});
          settle();
          return;
        }
        var onSettled = function () {
          img.removeEventListener('load', onSettled);
          img.removeEventListener('error', onSettled);
          if (typeof img.decode === 'function') img.decode().catch(function () {});
          settle();
        };
        img.addEventListener('load', onSettled);
        img.addEventListener('error', onSettled);
        img.loading = 'eager';
        setTimeout(onSettled, 5000); // a stalled fetch must not wedge the sweep
      }

      warmAdjacentMedia(target) {
        var items = [];
        this.querySelectorAll('.vtls-pi__media-item[data-vtls-media-id]').forEach(function (i) {
          if (!i.hidden) items.push(i);
        });
        var idx = items.indexOf(target);
        if (idx < 0 || items.length < 2) return;
        this.warmMediaItem(items[(idx + 1) % items.length]);
        this.warmMediaItem(items[(idx - 1 + items.length) % items.length]);
      }

      /* After the page settles, background-load the WHOLE gallery one image
         at a time: nearest-to-active first (the images arrows reach next),
         variant-attached media early (so the first variant switch is
         instant), then the rest by distance. The nearest-first walk runs
         over the VISIBLE figures — the same list the arrows step through —
         so with "Hide unselected variant media" on, the ±1 warms are the
         real next/prev arrow targets, not variant-hidden neighbors the
         arrows skip. Horizon gets its instant arrows by marking every
         gallery image eager in the markup; deferring ours to idle + loading
         sequentially keeps that feel without competing with the page's own
         critical requests. */
      warmInitialMedia() {
        var self = this;
        var run = function () {
          var all = [];
          self.querySelectorAll('.vtls-pi__media-item[data-vtls-media-id]').forEach(function (i) { all.push(i); });
          if (!all.length) return;
          var active = self.querySelector('.vtls-pi__media-item.is-active[data-vtls-media-id]') || all[0];
          var visible = all.filter(function (i) { return !i.hidden; });
          if (visible.indexOf(active) < 0) visible = all;
          var idx = visible.indexOf(active);
          var queue = [];
          var push = function (item) {
            if (item && item !== active && queue.indexOf(item) < 0) queue.push(item);
          };
          push(visible[(idx + 1) % visible.length]);
          push(visible[(idx - 1 + visible.length) % visible.length]);
          self.querySelectorAll('.vtls-pi__media-item[data-vtls-attached]').forEach(push);
          for (var d = 2; d < visible.length; d++) {
            push(visible[(idx + d) % visible.length]);
            push(visible[(idx - d + visible.length) % visible.length]);
          }
          all.forEach(push); // whatever's left (hidden media beyond the attached set)
          var next = function () {
            var item = queue.shift();
            if (item) self.warmMediaItem(item, next);
          };
          next();
        };
        if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 2000 });
        else setTimeout(run, 800);
      }

      /* ---------- media zoom (Horizon-style lightbox) ---------- */
      /* Fullscreen <dialog> holding every media: desktop scrolls the list
         vertically (click an image closes it, zoom-out cursor); mobile is a
         snap carousel where touch pinches/pans the image and the thumbnail
         strip is the navigation. Scroll drives the active thumbnail through
         an IntersectionObserver. All vtls- namespaced — no collision with
         Dawn's product-modal / media-gallery custom elements. */
      bindZoom() {
        var self = this;
        var dialog = this.querySelector('[data-vtls-zoom-dialog]');
        if (!dialog || typeof dialog.showModal !== 'function') return;
        this.zoomDialog = dialog;
        this.zoomLocked = false;
        this.zoomItems = Array.prototype.slice.call(dialog.querySelectorAll('[data-vtls-zoom-item]'));
        this.querySelectorAll('[data-vtls-zoom-open]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            self.openZoom(Number(btn.dataset.vtlsZoomOpen) || 0);
          });
        });
        var closeBtn = dialog.querySelector('[data-vtls-zoom-close]');
        if (closeBtn) closeBtn.addEventListener('click', function () { self.closeZoom(); });
        // Esc (the 'cancel' -> close path) lands here too; our own close
        // paths run the cleanup synchronously and the guard in onZoomClosed
        // makes this late delivery a no-op for them.
        dialog.addEventListener('close', function () { self.onZoomClosed(); });
        this.zoomItems.forEach(function (item) {
          // Clicking an image closes the lightbox — DESKTOP ONLY, and now
          // guarded at call time rather than by relying on preventDefault.
          // Since the pan wrapper stopped swallowing every touch (so swipe
          // can reach the carousel), a plain tap does synthesize a click on
          // mobile, and without this guard tapping the photo would close the
          // lightbox instead of doing nothing.
          if (item.hasAttribute('data-vtls-zoom-closer')) {
            item.addEventListener('click', function () {
              if (self.isZoomMobile()) return;
              self.closeZoom();
            });
          }
        });
        dialog.querySelectorAll('[data-vtls-zoom-thumb]').forEach(function (thumb) {
          thumb.addEventListener('click', function () {
            self.scrollZoomTo(Number(thumb.dataset.vtlsZoomThumb) || 0);
          });
        });
        dialog.querySelectorAll('[data-vtls-zoom-pan]').forEach(function (pan) {
          self.bindZoomPan(pan);
        });
      }

      isZoomMobile() {
        return window.matchMedia('(max-width: 749px)').matches;
      }

      openZoom(index) {
        var dialog = this.zoomDialog;
        if (!dialog || dialog.open) return;
        if (!this.zoomLocked) {
          // showModal() inerts the page but does not stop it scrolling
          // behind the lightbox — lock the root like Dawn's modals do.
          this.zoomPrevOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = 'hidden';
          this.zoomLocked = true;
        }
        dialog.showModal();
        this.resetZoomPans();
        this.watchZoomVisibility();
        var target = this.zoomItems[index];
        if (target) target.scrollIntoView({ behavior: 'auto', block: 'start', inline: 'start' });
        this.setActiveZoomThumb(index);
      }

      closeZoom() {
        var dialog = this.zoomDialog;
        if (!dialog) return;
        if (dialog.open) dialog.close();
        // The 'close' event is queued async (user-interaction task source) —
        // unlock immediately instead of waiting a task for the listener.
        this.onZoomClosed();
      }

      onZoomClosed() {
        // Runs from the dialog 'close' event AND directly on disconnect (the
        // event is queued async, too late for editor swaps) — idempotent.
        // The async delivery also means a close -> immediate reopen can fire
        // a stale 'close' AFTER the reopen; unlocking then would leave the
        // page scrollable behind the open lightbox, so bail if it is open.
        if (this.zoomDialog && this.zoomDialog.open) return;
        if (this.zoomLocked) {
          document.documentElement.style.overflow = this.zoomPrevOverflow || '';
          this.zoomLocked = false;
        }
        if (this.zoomObserver) {
          this.zoomObserver.disconnect();
          this.zoomObserver = null;
        }
        if (this.zoomActiveRaf) {
          cancelAnimationFrame(this.zoomActiveRaf);
          this.zoomActiveRaf = null;
        }
        if (this.zoomDialog) {
          this.zoomDialog.querySelectorAll('video').forEach(function (video) { video.pause(); });
        }
        this.resetZoomPans();
      }

      scrollZoomTo(index) {
        var target = this.zoomItems[index];
        if (!target) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start', inline: 'start' });
        this.setActiveZoomThumb(index);
      }

      setActiveZoomThumb(index) {
        var dialog = this.zoomDialog;
        if (!dialog) return;
        dialog.querySelectorAll('[data-vtls-zoom-thumb]').forEach(function (thumb) {
          var isActive = Number(thumb.dataset.vtlsZoomThumb) === index;
          thumb.classList.toggle('is-active', isActive);
          thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
          if (isActive) thumb.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        });
      }

      /* Keep the thumbnail rail in sync with the most-visible media while
         the lightbox scrolls (Horizon's behavior, persistent-observer
         flavor: ratios update continuously instead of re-observing on every
         debounced scroll tick). */
      watchZoomVisibility() {
        var self = this;
        if (this.zoomObserver) this.zoomObserver.disconnect();
        if (typeof IntersectionObserver !== 'function') return;
        var ratios = {};
        this.zoomRatios = ratios;
        this.zoomObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              ratios[entry.target.dataset.vtlsZoomItem] = entry.intersectionRatio;
            });
            self.scheduleZoomActiveUpdate();
          },
          { threshold: [0, 0.25, 0.5, 0.75, 1] }
        );
        this.zoomItems.forEach(function (item) { self.zoomObserver.observe(item); });
      }

      scheduleZoomActiveUpdate() {
        var self = this;
        if (this.zoomActiveRaf) return;
        this.zoomActiveRaf = requestAnimationFrame(function () {
          self.zoomActiveRaf = null;
          var ratios = self.zoomRatios || {};
          var best = -1;
          var bestRatio = 0;
          Object.keys(ratios).forEach(function (key) {
            if (ratios[key] > bestRatio) {
              bestRatio = ratios[key];
              best = Number(key);
            }
          });
          if (best >= 0) self.setActiveZoomThumb(best);
        });
      }

      resetZoomPans() {
        var dialog = this.zoomDialog;
        if (!dialog) return;
        // Open at 1x everywhere so the full image is visible (contained) on
        // mobile; pinch / double-tap still zoom from there. Desktop images
        // carry no transform (the media query never applies the CSS vars).
        var initialScale = 1;
        dialog.querySelectorAll('[data-vtls-zoom-pan]').forEach(function (pan) {
          var state = pan.vtlsZoomState;
          if (!state) return;
          state.scale = initialScale;
          state.x = 0;
          state.y = 0;
          state.dragging = false;
          state.moved = false;
          state.manualZoom = false;
          state.lastTapTime = 0;
          state.lastTapPos = null;
          pan.style.setProperty('--vtls-zoom-scale', String(state.scale));
          pan.style.setProperty('--vtls-zoom-x', '0px');
          pan.style.setProperty('--vtls-zoom-y', '0px');
          // Back to 1x means the browser owns the horizontal drag again, so
          // the reopened lightbox swipes instead of staying stuck panning.
          pan.classList.remove('is-zoomed');
        });
      }

      /* Port of Horizon's drag-zoom-wrapper (mobile only): pinch 1x-5x with
         the pinch midpoint held stationary, one-finger pan clamped to the
         image overflow, double-tap toggling 1x <-> 1.5x around the tap
         point. preventDefault also suppresses synthesized clicks, so the
         desktop click-to-close never fires from touch gestures. */
      bindZoomPan(pan) {
        var self = this;
        var minZoom = 1;
        var maxZoom = 5;
        var defaultZoom = 1.5;
        var state = {
          scale: minZoom, x: 0, y: 0,
          startScale: minZoom, startDist: 0,
          startPos: null, startX: 0, startY: 0,
          dragging: false, moved: false, manualZoom: false,
          lastTapTime: 0, lastTapPos: null, raf: null
        };
        pan.vtlsZoomState = state;

        var distance = function (x1, y1, x2, y2) {
          var dx = x1 - x2;
          var dy = y1 - y2;
          return Math.sqrt(dx * dx + dy * dy);
        };

        var apply = function () {
          state.raf = null;
          if (state.scale < minZoom) state.scale = minZoom;
          if (state.scale > maxZoom) state.scale = maxZoom;
          if (state.scale <= minZoom) {
            state.x = 0;
            state.y = 0;
          } else {
            // Clamp the pan to the visible overflow of the contained image
            // (same fit math as Horizon: object-fit contain around center).
            var rect = pan.getBoundingClientRect();
            var img = pan.querySelector('img');
            if (rect.width && rect.height && img) {
              var naturalW = img.naturalWidth || rect.width;
              var naturalH = img.naturalHeight || rect.width;
              var imgRatio = naturalW / naturalH;
              var fitW;
              var fitH;
              if (imgRatio > rect.width / rect.height) {
                fitW = rect.width;
                fitH = fitW / imgRatio;
              } else {
                fitH = rect.height;
                fitW = fitH * imgRatio;
              }
              var maxX = Math.max(0, fitW * state.scale - rect.width) / 2 / state.scale;
              var maxY = Math.max(0, fitH * state.scale - rect.height) / 2 / state.scale;
              if (state.x > maxX) state.x = maxX;
              if (state.x < -maxX) state.x = -maxX;
              if (state.y > maxY) state.y = maxY;
              if (state.y < -maxY) state.y = -maxY;
            }
          }
          pan.style.setProperty('--vtls-zoom-scale', String(state.scale));
          pan.style.setProperty('--vtls-zoom-x', state.x + 'px');
          pan.style.setProperty('--vtls-zoom-y', state.y + 'px');
          // Hands the one-finger drag to whichever behavior makes sense at
          // this scale: zoomed in -> touch-action:none so we pan the image;
          // fit to screen -> the browser keeps pan-x and swipes the slide row.
          pan.classList.toggle('is-zoomed', state.scale > minZoom + 0.01);
        };
        var schedule = function () {
          if (!state.raf) state.raf = requestAnimationFrame(apply);
        };
        // True while WE own the touches. At scale 1 the browser owns them so
        // the swipe carousel works, so preventDefault must be withheld —
        // calling it unconditionally is what blocked swipe entirely.
        var owningTouches = function () {
          return state.scale > minZoom + 0.01;
        };

        pan.addEventListener('touchstart', function (event) {
          if (!self.isZoomMobile()) return;
          // A pinch always belongs to us; a single touch only while zoomed in.
          // Withholding preventDefault at scale 1 is what lets the swipe
          // through — the double-tap branch below still claims its own.
          if (event.cancelable && (event.touches.length === 2 || owningTouches())) event.preventDefault();
          if (event.touches.length === 2) {
            var first = event.touches[0];
            var second = event.touches[1];
            state.startDist = distance(first.clientX, first.clientY, second.clientX, second.clientY);
            state.startScale = state.scale;
            state.dragging = false;
            return;
          }
          if (event.touches.length !== 1) return;
          var touch = event.touches[0];
          var now = Date.now();
          var isDoubleTap =
            state.lastTapPos &&
            now - state.lastTapTime < 300 &&
            distance(touch.clientX, touch.clientY, state.lastTapPos.x, state.lastTapPos.y) < 50;
          if (isDoubleTap) {
            // Claim the second tap even at scale 1: without this the browser
            // synthesizes a click, which the zoom-closer handler would treat
            // as "close the lightbox" mid double-tap-to-zoom.
            if (event.cancelable) event.preventDefault();
            var targetZoom;
            if (state.manualZoom) {
              targetZoom = minZoom;
              state.manualZoom = false;
            } else if (Math.abs(state.scale - minZoom) < 0.05) {
              targetZoom = defaultZoom;
            } else {
              targetZoom = minZoom;
            }
            if (targetZoom === minZoom) {
              state.scale = minZoom;
              state.x = 0;
              state.y = 0;
            } else {
              var oldScale = state.scale;
              state.scale = Math.min(maxZoom, targetZoom);
              var rect = pan.getBoundingClientRect();
              var scaleDelta = state.scale / oldScale - 1;
              state.x -= ((touch.clientX - (rect.left + rect.width / 2)) * scaleDelta) / state.scale;
              state.y -= ((touch.clientY - (rect.top + rect.height / 2)) * scaleDelta) / state.scale;
            }
            schedule();
            state.lastTapTime = 0;
            state.lastTapPos = null;
            state.dragging = false;
            return;
          }
          state.lastTapTime = now;
          state.lastTapPos = { x: touch.clientX, y: touch.clientY };
          state.startPos = { x: touch.clientX, y: touch.clientY };
          state.startX = state.x;
          state.startY = state.y;
          // Only arm the drag while zoomed in. At scale 1 there is nothing to
          // pan (apply() pins x/y to 0), and arming it would fight the
          // browser's own swipe scrolling for the same finger.
          state.dragging = owningTouches();
          state.moved = false;
        }, { passive: false });

        pan.addEventListener('touchmove', function (event) {
          if (!self.isZoomMobile()) return;
          if (event.cancelable && (event.touches.length === 2 || owningTouches())) event.preventDefault();
          if (event.touches.length === 2) {
            var first = event.touches[0];
            var second = event.touches[1];
            var oldScale = state.scale;
            var nextScale =
              (distance(first.clientX, first.clientY, second.clientX, second.clientY) / (state.startDist || 1)) *
              state.startScale;
            state.scale = Math.min(maxZoom, Math.max(minZoom, nextScale));
            state.manualZoom = true;
            var rect = pan.getBoundingClientRect();
            var midX = (first.clientX + second.clientX) / 2;
            var midY = (first.clientY + second.clientY) / 2;
            var scaleDelta = state.scale / oldScale - 1;
            state.x -= ((midX - (rect.left + rect.width / 2)) * scaleDelta) / state.scale;
            state.y -= ((midY - (rect.top + rect.height / 2)) * scaleDelta) / state.scale;
            state.dragging = false;
            schedule();
            return;
          }
          if (event.touches.length !== 1 || !state.dragging || !state.startPos) return;
          var touch = event.touches[0];
          var moveDist = distance(touch.clientX, touch.clientY, state.startPos.x, state.startPos.y);
          if (!state.moved && moveDist < 10) return;
          state.moved = true;
          state.x = state.startX + (touch.clientX - state.startPos.x) / state.scale;
          state.y = state.startY + (touch.clientY - state.startPos.y) / state.scale;
          schedule();
        }, { passive: false });

        pan.addEventListener('touchend', function (event) {
          if (event.touches.length === 0) {
            state.dragging = false;
            state.moved = false;
            schedule();
          }
        });
      }

      /* ---------- quantity ---------- */
      bindQty() {
        var self = this;
        var input = this.querySelector('[data-vtls-qty-input]');
        if (!input) return;
        // Activate the in-form mirror (see its comment in the form markup):
        // once named it becomes the last "quantity" entry in the form's data,
        // so descendant-scanning scripts and native submits read the synced
        // value instead of missing the out-of-form selector.
        var mirror = this.querySelector('[data-vtls-qty-mirror]');
        if (mirror) {
          mirror.name = 'quantity';
          mirror.value = input.value;
        }
        // 'input' covers typing; 'change' covers programmatic writes from cart
        // apps that set the value and dispatch change (e.g. Vitals Volume
        // Discount syncing the tier quantity onto the page selector).
        var isFreshInput = !input.dataset.vtlsBound;
        if (isFreshInput) {
          input.dataset.vtlsBound = '1';
          input.addEventListener('input', function () { self.syncQtyMirror(); });
        }
        // The input must never end up empty: clamp on commit (change fires on
        // blur-after-edit and on programmatic writes; blur catches clear-and-
        // leave, including focus moving to the ATC button). Live typing stays
        // free so multi-digit values can be entered.
        var clampQty = function () {
          var min = Number(input.min || 1);
          var next = Math.floor(Number(input.value));
          if (input.value === '' || isNaN(next) || next < min) next = min;
          if (input.max && next > Number(input.max)) next = Number(input.max);
          input.value = next;
        };
        if (isFreshInput) {
          input.addEventListener('change', function () { clampQty(); self.syncQtyMirror(); });
          input.addEventListener('blur', function () { clampQty(); self.syncQtyMirror(); });
        }
        this.querySelectorAll('[data-vtls-qty]').forEach(function (btn) {
          if (btn.dataset.vtlsBound) return;
          btn.dataset.vtlsBound = '1';
          btn.addEventListener('click', function () {
            var step = Number(input.step || 1) * Number(btn.dataset.vtlsQty);
            var next = Number(input.value || 1) + step;
            var min = Number(input.min || 1);
            if (next < min) next = min;
            if (input.max && next > Number(input.max)) next = Number(input.max);
            input.value = next;
            self.syncQtyMirror();
          });
        });
      }

      syncQtyMirror() {
        var input = this.querySelector('[data-vtls-qty-input]');
        var mirror = this.querySelector('[data-vtls-qty-mirror]');
        if (input && mirror) mirror.value = input.value;
      }

      /* Mirror the theme buttons' add feedback: swap the label for the
         checkmark, hold, then restore. Fired from this section's own add
         path AND from the cart-lines-update listener (Vitals-intercepted
         adds) — a double trigger is harmless, the timer just resets. */
      showAtcSuccess() {
        var atc = this.querySelector('[data-vtls-atc]');
        if (!atc || !atc.querySelector('.vtls-pi__atc-check')) return;
        atc.classList.add('vtls-pi__atc--added');
        clearTimeout(this.atcSuccessTimer);
        // Timed state restore for the confirmation hold, like theme buttons.
        this.atcSuccessTimer = setTimeout(function () {
          atc.classList.remove('vtls-pi__atc--added');
        }, 1600);
      }

      /* ---------- add to cart ---------- */
      bindForm() {
        var self = this;
        var form = this.querySelector('.vtls-pi__form');
        if (!form) return;
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          self.addToCart(form);
        });
      }

      addToCart(form) {
        var self = this;
        var atc = this.querySelector('[data-vtls-atc]');
        var errorEl = this.querySelector('[data-vtls-atc-error]');
        var addedEl = this.querySelector('[data-vtls-added]');
        if (errorEl) errorEl.hidden = true;
        if (addedEl) addedEl.hidden = true;
        if (atc && atc.disabled) return;

        // Gift-card recipient email: validate client-side before submitting so an
        // invalid address shows the browser's native message ("Please include an
        // '@'…"), matching the theme's default gift-card form, instead of round-
        // tripping to /cart/add. The product form is novalidate, but an explicit
        // reportValidity() still runs; only the enabled recipient-mode email is
        // checked (the disabled 'My email' field is skipped).
        var gcEmail = this.querySelector('[data-vtls-gc-email]');
        if (gcEmail && !gcEmail.disabled && typeof gcEmail.reportValidity === 'function') {
          this.validateGcEmail();
          if (!gcEmail.reportValidity()) return;
        }

        if (atc) {
          atc.setAttribute('aria-busy', 'true');
          // Hard-block re-entry: a second quick click must not start another
          // /cart/add while this one is in flight. syncAtcState restores the
          // real state in the finally below.
          atc.disabled = true;
        }

        var formData = new FormData(form);

        // The submitted quantity always comes from the visible selector at
        // click time — collapses the associated-input + mirror pair into one
        // entry and survives any association quirk.
        var qtyVisible = this.querySelector('[data-vtls-qty-input]');
        if (qtyVisible && qtyVisible.value) formData.set('quantity', qtyVisible.value);

        // Subscription app blocks (@app) may inject their selling_plan input
        // outside our form (or into the installments form). Scoop it up so the
        // add still carries the plan — but only when the section has no native
        // Purchase options block. When that block exists, its selection is
        // authoritative: one-time purchase disables the hidden input on
        // purpose, and copying an app widget's plan would contradict the
        // displayed one-time price.
        if (!formData.get('selling_plan') && !this.querySelector('[data-vtls-plan-radio]')) {
          var planInputs = this.querySelectorAll('input[name="selling_plan"]:not([disabled]), select[name="selling_plan"]');
          for (var i = 0; i < planInputs.length; i++) {
            var candidate = planInputs[i];
            if (candidate.type === 'radio' && !candidate.checked) continue;
            if (candidate.value) { formData.set('selling_plan', candidate.value); break; }
          }
        }

        // Path 1 — Dawn family: let the theme's own cart element declare which
        // sections it needs, exactly like Dawn's product-form.js does. Take
        // the first element that actually implements the contract — a present
        // but inert cart-notification must not mask a working cart-drawer.
        var themeCartCandidates = [
          document.querySelector('cart-notification'),
          document.querySelector('cart-drawer'),
        ];
        var themeCart = null;
        for (var tc = 0; tc < themeCartCandidates.length; tc++) {
          if (themeCartCandidates[tc] && typeof themeCartCandidates[tc].getSectionsToRender === 'function') {
            themeCart = themeCartCandidates[tc];
            break;
          }
        }
        if (themeCart) {
          try {
            formData.append(
              'sections',
              themeCart.getSectionsToRender().map(function (s) { return s.id; }).join(',')
            );
            formData.append('sections_url', window.location.pathname);
            if (typeof themeCart.setActiveElement === 'function') {
              themeCart.setActiveElement(document.activeElement);
            }
          } catch (e) { themeCart = null; }
        }

        // Path 2 — Horizon-family cart components. Two generations exist:
        //  (a) Current Horizon ships a theme-local events module pinned as
        //      `@theme/events` in its importmap. All consumers listen for its
        //      bubbling `cart:update` DOM event: `cart-icon` adds
        //      detail.data.itemCount to the bubble when data.source is
        //      'product-form-component', `cart-items-component` morphs from
        //      detail.data.sections[sectionId] (self-refetches when absent),
        //      and `cart-drawer-component` auto-opens only when the theme
        //      setting gave it the `auto-open` attribute.
        //  (b) Older Horizon-family themes consume `shopify:cart:lines-update`
        //      from `@shopify/events` (or Shopify's CDN copy) with a deferred
        //      promise resolved after the add.
        // We detect (a) by the importmap entry and mimic the theme's own
        // product-form dispatch verbatim; otherwise we fall back to (b).
        // Any standard component present means the theme consumes these
        // events — not just the drawer. With the theme's cart set to
        // PAGE mode there is no cart-drawer-component, but the header
        // cart-icon still derives its count bubble from this event; gating on
        // the drawer alone left the bubble stale after our adds there.
        var standardTarget =
          !themeCart && document.querySelector('cart-drawer-component, cart-items-component, cart-icon');
        if (standardTarget) {
          var sectionIds = [];
          var addSectionId = function (id) {
            if (id && sectionIds.indexOf(id) === -1) sectionIds.push(id);
          };
          // Resolves a section id from the enclosing `shopify-section-*`
          // wrapper for elements that carry no `data-section-id` of their own.
          var sectionIdFromWrapper = function (el) {
            var wrapper = el && el.closest('[id^="shopify-section-"]');
            return wrapper ? wrapper.id.replace('shopify-section-', '') : '';
          };
          // Item list. `cart-items-component` carries its own section id.
          document.querySelectorAll('cart-items-component').forEach(function (el) {
            addSectionId(el.dataset.sectionId);
          });
          // Drawer wrapper section (fallback when `cart-items-component` has
          // no explicit `data-section-id`).
          addSectionId(sectionIdFromWrapper(document.querySelector('cart-drawer-component')));
          // Header count bubble section. `cart-icon` has no `data-section-id`;
          // without its section the drawer refreshes but the header cart
          // count stays stale.
          addSectionId(sectionIdFromWrapper(document.querySelector('cart-icon')));
          if (sectionIds.length) {
            formData.append('sections', sectionIds.join(','));
            formData.append('sections_url', window.location.pathname);
          }
        }

        var quantity = Number(formData.get('quantity')) || 1;

        // Importmap probe for the current-Horizon theme-local events module.
        var hasThemeEvents = false;
        if (standardTarget) {
          try {
            var importmapEl = document.querySelector('script[type="importmap"]');
            hasThemeEvents =
              !!importmapEl && '@theme/events' in (JSON.parse(importmapEl.textContent).imports || {});
          } catch (e) { /* malformed importmap — treat as absent */ }
        }

        var performAdd = function (eventsModule, deferred, themeEvents) {
          // Set once the add itself lands: the catch below must never fall
          // back to a native re-submit after a successful add (double-add).
          var added = false;
          fetch(self.dataset.cartAddUrl + '.js', {
            method: 'POST',
            headers: { Accept: 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' },
            body: formData,
          })
            .then(function (response) { return response.json().then(function (json) { return { ok: response.ok, json: json }; }); })
            .then(function (result) {
              if (!result.ok || result.json.status) {
                var payload = result.json;
                // Normal cart errors put a human string in `description`. Gift-card
                // recipient validation instead returns `description` as an OBJECT
                // ({ email: ['is invalid'] }) with the readable text in `message`
                // ("Validation failed: Email is invalid") — assigning the object to
                // textContent rendered "[object Object]". Prefer a string description,
                // else the message string; strip Shopify's "Validation failed:" prefix.
                var message =
                  (typeof payload.description === 'string' && payload.description) ||
                  (typeof payload.message === 'string' && payload.message) ||
                  (errorEl && errorEl.dataset.fallbackError) ||
                  'Could not add to cart.';
                message = message.replace(/^Validation failed:\s*/i, '');
                if (errorEl) { errorEl.textContent = message; errorEl.hidden = false; }
                if (deferred) deferred.resolve({ cart: null, detail: { didError: true, source: 'vtls-product-info' } });
                return;
              }
              added = true;
              self.showAtcSuccess();
              document.dispatchEvent(
                new CustomEvent('vtls:cart:added', { bubbles: true, detail: { item: result.json } })
              );
              // Generic nudge some themes listen to; harmless elsewhere.
              document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

              if (themeEvents) {
                // Current Horizon: one bubbling `cart:update` feeds all three
                // consumers. `source: 'product-form-component'` keeps the
                // header bubble incremental (+= itemCount), exactly like the
                // theme's own form; cart-items morphs from the sections HTML
                // our add request asked for.
                self.dispatchEvent(
                  new themeEvents.CartAddEvent({}, self.id || 'vtls-product-info', {
                    source: 'product-form-component',
                    itemCount: quantity,
                    productId: self.dataset.productId,
                    sections: result.json.sections,
                  })
                );
                // Horizon's own form never navigates: without a drawer the
                // header bubble (plus our checkmark and note) is the whole
                // feedback, exactly like the theme's native add.
                var hasThemeDrawer = !!document.querySelector('cart-drawer-component');
                self.flyToCart(atc);
                if (!hasThemeDrawer && addedEl) addedEl.hidden = false;
                return;
              }

              if (deferred && eventsModule) {
                // Standard-events consumers want the full cart state; fetch it
                // like Horizon's own product-form does, then resolve. Kicked
                // off before any navigation decision — the header bubble
                // listener consumes it when we stay on the page.
                fetch(self.dataset.cartUrl + '.js', { headers: { Accept: 'application/json' } })
                  .then(function (r) { return r.json(); })
                  .then(function (cartJson) {
                    deferred.resolve({
                      cart: eventsModule.CartLinesUpdateEvent.createCartFromAjaxResponse(cartJson),
                      detail: {
                        didError: false,
                        items: cartJson.items,
                        source: 'vtls-product-info',
                        sourceId: self.id || 'vtls-product-info',
                        itemCount: quantity,
                        sections: result.json.sections,
                      },
                    });
                  })
                  .catch(deferred.reject);

                // A drawer presents the add on the spot, superseding the
                // configured after-ATC behavior (the setting's info text says
                // so). Without one — theme cart set to PAGE mode — the event
                // only refreshes the header bubble, too subtle as the sole
                // feedback, so the configured behavior still applies.
                // Same contract as the theme-events branch: stay on the page.
                var hasDrawerComponent = !!document.querySelector('cart-drawer-component');
                self.flyToCart(atc);
                if (!hasDrawerComponent && addedEl) addedEl.hidden = false;
                return;
              }

              if (themeCart && typeof themeCart.renderContents === 'function') {
                try {
                  themeCart.renderContents(result.json);
                  return;
                } catch (e) { /* fall through to configured behavior */ }
              }
              // No theme cart infrastructure at all: match what the native
              // form post would have done and land on the cart page.
              window.location.href = self.dataset.cartUrl;
            })
            .catch(function (err) {
              // Post-add side effects (theme cart events, drawer wiring) share
              // this chain: once the add succeeded, a later throw must NOT
              // trigger the native fallback or the item is added twice.
              if (added) {
                if (window.console && console.warn) console.warn('vtls post-add step failed', err);
                return;
              }
              if (deferred) deferred.reject(new Error('vtls add to cart failed'));
              // The add never happened: native submit is the last resort.
              form.submit();
            })
            .finally(function () {
              if (atc) atc.removeAttribute('aria-busy');
              // Undo the in-flight disable; the current payload decides the
              // real button state (available / sold out / unavailable).
              self.syncAtcState();
            });
        };

        // Horizon generations disagree on where cart events live: some builds
        // export CartAddEvent from their theme-local @theme/events, others
        // keep no cart classes there and consume @shopify/events standard
        // events instead (both observed on Horizon 4.x in the wild). Gate on
        // CAPABILITY, not module presence — a resolving @theme/events without
        // CartAddEvent must still fall through to the standard-events flow.
        var startStandardEventsAdd = function () {
          // Prefer the theme's pinned @shopify/events (via its importmap), fall
          // back to Shopify's CDN copy. Both expose the same event classes.
          import('@shopify/events')
            .catch(function () { return import('https://cdn.shopify.com/storefront/standard-events.js'); })
            .then(function (eventsModule) {
              var deferred = eventsModule.CartLinesUpdateEvent.createPromise();
              self.dispatchEvent(
                new eventsModule.CartLinesUpdateEvent({
                  action: 'add',
                  context: 'product',
                  lines: [
                    {
                      // Horizon cart listeners match lines by Storefront API
                      // merchandise gid, not the raw numeric variant id.
                      merchandiseId: 'gid://shopify/ProductVariant/' + String(formData.get('id')),
                      quantity: quantity,
                    },
                  ],
                  promise: deferred.promise,
                })
              );
              performAdd(eventsModule, deferred);
            })
            .catch(function () { performAdd(null, null); });
        };

        if (standardTarget && hasThemeEvents) {
          import('@theme/events')
            .then(function (themeEvents) {
              if (themeEvents && typeof themeEvents.CartAddEvent === 'function') {
                performAdd(null, null, themeEvents);
              } else {
                startStandardEventsAdd();
              }
            })
            .catch(function () { startStandardEventsAdd(); });
        } else if (standardTarget) {
          startStandardEventsAdd();
        } else {
          performAdd(null, null);
        }
      }

      /* Horizon's fly-to-cart animation: reuse the theme's own <fly-to-cart>
         element when it's registered (its script may not be loaded when this
         section replaces the theme's product section — then we just skip). */
      flyToCart(sourceEl) {
        if (!customElements.get('fly-to-cart') || !sourceEl) return;
        var cartIcon = document.querySelector('.header-actions__cart-icon');
        var image = this.querySelector('.vtls-pi__media-item.is-active img, .vtls-pi__media-item img');
        if (!cartIcon || !image) return;
        try {
          var fly = document.createElement('fly-to-cart');
          fly.classList.add('fly-to-cart--main');
          fly.style.setProperty('background-image', 'url(' + (image.currentSrc || image.src) + ')');
          fly.style.setProperty('--start-opacity', '0');
          fly.source = sourceEl;
          fly.destination = cartIcon;
          document.body.appendChild(fly);
        } catch (e) { /* animation is decorative — never block the add */ }
      }
    }

    customElements.define('vtls-product-info', VtlsProductInfo);
  })();
</script>

{%- comment -%}
  EDITOR STRUCTURE LOCK — CON-3344.
  The preset tree in the schema below is the approved default sidebar
  structure (Product media / Details -> Product title, Price, Product
  badges, Benefits list, Selectors -> (Variant selector, Quantity
  selector), Buy buttons, Description tabs). Order, the set of default
  blocks, AND the display names of the referenced blocks are locked.
  Any change here or to a referenced block's schema "name" must update
  editor-structure.lock.json in the same commit — verify with
  `node apps/pagegen-theme-sections/product-info/check-editor-structure.mjs`. Updating the
  lock file is the explicit confirmation that the structure change is
  intentional; without it the check fails and the change must not ship.
{%- endcomment -%}
{% schema %}
{
  "name": "🧡 Vitals Product Info",
  "tag": "section",
  "class": "vtls-product-info-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "blocks": [
    {
      "type": "_vtls-product-media"
    },
    {
      "type": "_vtls-details"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Page"
    },
    {
      "type": "select",
      "id": "page_background_type",
      "label": "Page background",
      "info": "Overrides the theme page background.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "page_background_color",
      "label": "Color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.page_background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "page_background_gradient",
      "label": "Gradient",
      "default": "linear-gradient(135deg, #EEF1EA, #D8E0CE)",
      "visible_if": "{{ section.settings.page_background_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Product info background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(135deg, #EEF1EA, #D8E0CE)",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap (desktop)",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
