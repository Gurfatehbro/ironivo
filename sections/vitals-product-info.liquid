{%- comment -%}VERSION-154{%- endcomment -%}
{%- comment -%}
  Product Information — paste-test artifact, not shipped.
  The VERSION-<n> marker above is the God-mode theme-section version contract:
  the backend scans the raw file for /VERSION-\d+/ (defaults to 1 when absent).
  Bump it on every content change once this ships through the S3 pipeline.

  Brand name: every merchant-visible occurrence of the app name is the
  BE__PROJECT_NAME placeholder (spelled out below as an HTML comment; not
  written in full here, or this note would be substituted too), never a
  literal "Vitals". The schema/preset display names also carry the
  BE__PROJECT_ICON placeholder in front (App::APP_ID_TO_ICON — 🧡 for Vitals,
  ❤️ for the Theme Sections app), matching the library sections' editor look.
  The backend substitutes both per installing app on every
  bundle file, at install time (ThemeAssetCreationService::replaceVariables,
  called from
  ThemeSectionBundleInstallService::loadBundleFiles) — App::THEME_SECTIONS_NICE_NAMES
  maps the Vitals app to "Vitals" and the Theme Sections app to "Square", so a
  Square merchant never sees "Vitals" in the theme editor. This has to be an
  install-time substitution: the schema block below is parsed as static JSON —
  Liquid inside it is never evaluated — so a section's display name cannot be
  resolved at render time. Same mechanism the library uses in sources/. The raw
  placeholder is an HTML comment, so an unsubstituted file (local paste-test)
  degrades to an invisible node in markup rather than visible text.

  Design goals:
  - Multi-file since VERSION-10: this section hosts private theme blocks
    (blocks/_vtls-*.liquid) rendered via content_for, giving the editor the
    nested Media / Details / Selectors sidebar tree. No snippets, no external
    requests; CSS + runtime stay centralized here (block markup only moves).
  - Native buy machinery: real {% form 'product' %}, {{ form | payment_button }},
    {{ form | payment_terms }} — Shopify hydrates dynamic checkout itself.
  - Theme-agnostic: no font-family anywhere (inherits theme body font), all
    fallback styles use :where() (zero specificity, any theme .button rule wins),
    everything namespaced vtls- (no collisions with Dawn's custom elements).
  - Cart add: AJAX; integrates with Dawn-family cart-notification/cart-drawer via
    their own getSectionsToRender()/renderContents(); otherwise the after-add
    behavior inherits the theme family's native one (Dawn-family page carts
    navigate to /cart, Horizon-family stays put with the bubble updated).
    Without JS the form posts natively.
  - Media zoom: Horizon-style click-to-expand lightbox on gallery images — a
    fullscreen <dialog> (vertical scroll on desktop, click image to close;
    snap carousel with pinch/drag/double-tap zoom on mobile) with a synced
    thumbnail rail. Toggled per block ("Enable zoom" on Product media).
  - Deferred on purpose (v1): gift-card recipient form, pickup availability,
    selling-plan UI (subscription apps mount via the @app block).
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'vtls-pi-form-' | append: section.id

  # Zoom lightbox backdrop: follow the merchant's section background so the
  # expanded view reads as part of the same surface; plain white otherwise.
  assign zoom_dialog_bg = '#ffffff'
  if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)'
    assign zoom_dialog_bg = section.settings.background_color
  endif

  # Opportunistic theme translations: most OS 2.0 themes ship the standard
  # products.product.* locale keys, so multilingual stores get per-locale
  # strings for free. A missing key renders "Translation missing: ..." which
  # we detect and replace with our English default. Merchant-customized
  # settings always win over both (resolved at each block below).
  assign d_atc = 'products.product.add_to_cart' | t
  assign d_soldout = 'products.product.sold_out' | t
  assign d_unavailable = 'products.product.unavailable' | t
  assign d_qty = 'products.product.quantity.label' | t
  assign d_tax = 'products.product.taxes_included' | t
  assign d_sale = 'products.product.on_sale' | t
  assign d_sku = 'products.product.sku' | t
  assign d_in_stock = 'products.product.inventory_in_stock' | t
  assign d_low = 'products.product.inventory_low_stock' | t
  assign d_low_count = 'products.product.inventory_low_stock_show_count' | t: quantity: '[count]'
  assign d_out = 'products.product.inventory_out_of_stock' | t
  assign d_backorder = 'products.product.inventory_out_of_stock_continue_selling' | t
  assign d_added = 'general.cart.item_added' | t

  assign vtls_probe = d_atc | downcase
  if vtls_probe contains 'translation missing'
    assign d_atc = 'Add to cart'
  endif
  assign vtls_probe = d_soldout | downcase
  if vtls_probe contains 'translation missing'
    assign d_soldout = 'Sold out'
  endif
  assign vtls_probe = d_unavailable | downcase
  if vtls_probe contains 'translation missing'
    assign d_unavailable = 'Unavailable'
  endif
  assign vtls_probe = d_qty | downcase
  if vtls_probe contains 'translation missing'
    assign d_qty = 'Quantity'
  endif
  assign vtls_probe = d_tax | downcase
  if vtls_probe contains 'translation missing'
    assign d_tax = 'Tax included.'
  endif
  assign vtls_probe = d_sale | downcase
  if vtls_probe contains 'translation missing'
    assign d_sale = 'Sale'
  endif
  assign vtls_probe = d_sku | downcase
  if vtls_probe contains 'translation missing'
    assign d_sku = 'SKU'
  endif
  assign vtls_probe = d_in_stock | downcase
  if vtls_probe contains 'translation missing'
    assign d_in_stock = 'In stock'
  endif
  assign vtls_probe = d_low | downcase
  if vtls_probe contains 'translation missing'
    assign d_low = 'Low stock'
  endif
  assign vtls_probe = d_low_count | downcase
  if vtls_probe contains 'translation missing'
    assign d_low_count = 'Low stock — [count] left'
  endif
  assign vtls_probe = d_out | downcase
  if vtls_probe contains 'translation missing'
    assign d_out = 'Out of stock'
  endif
  assign vtls_probe = d_backorder | downcase
  if vtls_probe contains 'translation missing'
    assign d_backorder = 'In stock — ships soon'
  endif
  assign vtls_probe = d_added | downcase
  if vtls_probe contains 'translation missing'
    assign d_added = 'Added to cart'
  endif
-%}

{%- style -%}
  #vtls-pi-{{ section.id }} {
    display: block;
    padding-top: calc({{ section.settings.padding_top_mobile }}px + var(--vtls-header-offset, 0px));
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    {%- case section.settings.background_type %}
    {%- when 'color' %}
    background: {{ section.settings.background_color }};
    {%- when 'gradient' %}
    background: {{ section.settings.background_gradient }};
    {%- endcase %}
  }
  /* Horizon-family transparent header: the theme pulls the FIRST template
     section under the floating header (base.css: body:has(.header[transparent])
     .content-for-layout > .shopify-section:first-child gets margin-top:
     -var(--header-group-height)) and native sections push their content back
     down via .spacing-style's --section-top-offset. Our section has no
     .spacing-style, so mirror that exact rule: same first-child scope, same
     --header-height x --transparent-header-offset-boolean formula (both are
     set on <body> by the theme's inline layout script). Off Horizon-family
     neither var exists, the fallbacks zero the calc, and padding-top keeps
     the merchant's setting only. */
  main > .shopify-section:first-child #vtls-pi-{{ section.id }} {
    --vtls-header-offset: calc(var(--header-height, 0px) * var(--transparent-header-offset-boolean, 0));
  }
  {%- liquid
    assign vtls_page_bg = ''
    case section.settings.page_background_type
      when 'color'
        assign vtls_page_bg = section.settings.page_background_color
      when 'gradient'
        assign vtls_page_bg = section.settings.page_background_gradient
    endcase
  -%}
  {%- if vtls_page_bg != blank and vtls_page_bg != 'rgba(0,0,0,0)' %}
  /* Page background override, part 1 (both theme families): paint <body>.
     Beats Dawn's class-scoped body/gradient rules and Horizon's plain body
     rule alike via an important'd shorthand. On Dawn-family this is the
     whole fix; on Horizon it's occluded by each section's backing layer,
     which part 2 (the script after this style block) handles. Renders only
     on the product page, where this section lives. */
  body { background: {{ vtls_page_bg }} !important; }
  {%- endif %}
  {%- if section.settings.page_background_type == 'color' and section.settings.page_background_color != blank and section.settings.page_background_color != 'rgba(0,0,0,0)' %}
  /* Keep the scrollbar neutral on Horizon: its WebKit track is transparent
     and would show the (now page-coloured) body through it. Repaint the
     track with the theme's ORIGINAL page bg, captured into
     --vtls-scrollbar-bg by the script above, so the scrollbar matches the
     rest of the site. Off Horizon the var is unset -> transparent (no-op).
     Firefox is handled by the script restoring scrollbar-color directly. */
  ::-webkit-scrollbar-track { background-color: var(--vtls-scrollbar-bg, transparent) !important; }
  {%- endif %}
  @media screen and (min-width: 750px) {
    #vtls-pi-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px + var(--vtls-header-offset, 0px));
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
  #vtls-pi-{{ section.id }} .vtls-pi__inner {
    margin: 0 auto;
    /* Mobile left-right padding is merchant-configurable (default 16px),
       replacing the old hardcoded 1.5rem; desktop keeps the 1.5rem gutter. */
    padding-left: {{ section.settings.padding_x_mobile }}px;
    padding-right: {{ section.settings.padding_x_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    /* Width % / max-width apply to desktop only. On mobile the section fills
       the theme's page container and Left-right padding controls the inset. */
    #vtls-pi-{{ section.id }} .vtls-pi__inner {
      width: {{ section.settings.section_width }}%;
      {%- if section.settings.custom_max_width != blank %}
      max-width: {{ section.settings.custom_max_width }}px;
      {%- endif %}
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  #vtls-pi-{{ section.id }} .vtls-pi__grid {
    display: grid;
    /* minmax(0, 1fr), not 1fr: with the media column inside the padded inner
       on mobile (no full-bleed break-out), the horizontal-scroll thumbnail
       carousel must not grow the track past the available width. */
    grid-template-columns: minmax(0, 1fr);
    /* Mobile (single-column) gap is the vertical space between the stacked
       media and details; desktop overrides with the column gap below. */
    gap: {{ section.settings.gap_mobile }}px;
  }
  /* Empty-state blocks keep a hidden editor anchor; their content_for
     wrappers must not consume a grid gap slot. */
  #vtls-pi-{{ section.id }} .vtls-pi__grid > *:empty,
  #vtls-pi-{{ section.id }} .vtls-pi__grid > *:has(> .vtls-pi__empty-anchor) { display: none; }
  @media screen and (min-width: 750px) {
    /* 750, not 990: Dawn and Horizon both go two-column at 750, and the
       theme-editor desktop canvas with the settings panel open is often
       narrower than 990 — at 990 the media Width/Position settings looked
       dead while merchants toggled them (each panel is ~300px wide). */
    /* The media column's side follows the BLOCK ORDER — merchants drag the
       Product media block above or below Details to flip sides (CON-3350
       removed the Media position setting). :has() keys the track widths to
       wherever the media column actually sits, and a section with no media
       block at all keeps the single-column base template instead of
       squeezing Details into half the grid. The Product media block's own
       style overrides these same selectors when its width isn't medium. */
    #vtls-pi-{{ section.id }} .vtls-pi__grid {
      align-items: start;
      gap: {{ section.settings.gap }}px;
    }
    /* content_for 'blocks' wraps every block in an anonymous div (e.g.
       .shopify-block), so grid items are wrappers — match the media column
       through the wrapper, not as a direct child. */
    #vtls-pi-{{ section.id }} .vtls-pi__grid:has(> :first-child .vtls-pi__media-col) {
      grid-template-columns: 50% minmax(0, 1fr);
    }
    #vtls-pi-{{ section.id }} .vtls-pi__grid:has(> :not(:first-child) .vtls-pi__media-col) {
      grid-template-columns: minmax(0, 1fr) 50%;
    }
    /* No product media (e.g. gift cards): the media block renders nothing, so
       collapse to a single CENTERED column instead of leaving an empty media
       side — matches Horizon's no-image product layout. */
    #vtls-pi-{{ section.id }} .vtls-pi__grid:not(:has(.vtls-pi__media-col)) {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__grid:not(:has(.vtls-pi__media-col)) > * {
      width: 100%;
      max-width: 480px;
    }
    /* Always sticky, BOTH columns (CON-3344 removed the merchant toggle;
       media joined the pair so an opened tabs/description column keeps the
       gallery on screen). Geometry copied from Horizon's .sticky-content
       (assets/base.css): flush to the viewport top, and the GALLERY never
       compensates for the theme header — native Horizon lets it slide under
       its (default always-)sticky header, media occlusion is cosmetic.
       Whichever column is shorter follows the scroll until the section's
       row is spent; the taller one fills the row and never moves. Sticky
       must sit on the content_for WRAPPER: the wrapper is the grid item, so
       its containing block is the grid AREA (full row height) and
       align-items:start leaves it travel room. On the inner .vtls-pi__info /
       .vtls-pi__media-col it is inert — their parent wrapper is exactly as
       tall as they are. */
    #vtls-pi-{{ section.id }} .vtls-pi__grid > *:has(.vtls-pi__media-col),
    #vtls-pi-{{ section.id }} .vtls-pi__grid > *:has(.vtls-pi__info) {
      position: sticky;
      top: 0;
    }
    /* Horizon-family only, copied from product-information-content.liquid:
       WHILE the sticky header is on screen (data-sticky-state='active'),
       the info column sticks underneath it so the buy box stays reachable —
       --header-height is maintained on <body> by Horizon's header.js, and
       in scroll-up header mode the offset comes and goes with the header,
       exactly like the native product-details column. Other theme families
       never match the selector and keep top: 0. */
    body:has(#header-group #header-component[data-sticky-state='active']) #vtls-pi-{{ section.id }} .vtls-pi__grid > *:has(.vtls-pi__info) {
      top: var(--header-height, 0px);
    }
  }

  /* ---- media gallery ---- */
  #vtls-pi-{{ section.id }} .vtls-pi__media-item {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__media-item > img,
  #vtls-pi-{{ section.id }} .vtls-pi__media-item > video,
  #vtls-pi-{{ section.id }} .vtls-pi__media-item > iframe,
  #vtls-pi-{{ section.id }} .vtls-pi__media-item > model-viewer {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Reserve the media box from the preview aspect ratio BEFORE the image
     loads, so a hidden->shown figure never collapses the column (each figure
     carries its own --vtls-media-ratio inline). Fixed-ratio mode overrides
     this from the block file (renders later, equal specificity); constrain
     mode combines its width rule with this ratio (height = width / ratio). */
  #vtls-pi-{{ section.id }} .vtls-pi__media-item { aspect-ratio: var(--vtls-media-ratio, 1); }
  /* Desktop single-gallery layout (CON-3344): large image + thumbnails
     below; only the active figure renders and the swap is decode-gated in
     the runtime (no blank flash). Mobile swaps this stacked mode for a real
     scroll-snap swipe carousel — see the max-width block after the
     cross-fade rules. */
  @media screen and (min-width: 750px) {
    #vtls-pi-{{ section.id }} .vtls-pi__media-item { display: none; }
    #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-active { display: block; }
  }
  /* The stage anchors the overlay arrows (they must NOT live inside the
     list: absolute children of a scroller travel with the scrolled canvas
     on mobile); the list anchors the desktop cross-fade's inset overlay.
     Both wrap the same box. */
  #vtls-pi-{{ section.id }} .vtls-pi__media-stage { position: relative; }
  #vtls-pi-{{ section.id }} .vtls-pi__media-list { position: relative; }
  /* Cross-fade (Horizon feel): the OUTGOING figure is lifted over the list
     and faded out while the already-decoded incoming figure shows beneath. */
  #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-leaving {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.25s ease;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-leaving.is-fading { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-leaving { transition: none; }
  }
  /* Mobile: Horizon-style scroll-snap swipe carousel (slideshow-slides
     pattern) — every visible figure is a full-width slide in a native
     horizontal scroller, so touch swipe needs no gesture code. The runtime
     keeps .is-active + the thumb rail in sync with the settled slide
     (bindMediaSwipe) and routes arrows/thumbs/variant changes through
     scrollCarouselTo.

     Two-stage on purpose (VERSION-146). The runtime lives in a ~90KB
     <script> AFTER this markup, so the browser routinely paints the gallery
     before it ever executes (the parser stalls waiting for those bytes on
     any cold load). A carousel that starts at scrollLeft 0 and is scrolled
     onto the active slide by JS therefore paints the WRONG media first —
     and, because only the active figure is eager/high-priority, that first
     frame is an empty ratio box followed by a jump. So the pre-JS state
     below is already correct without any script: the row is clipped to one
     slot and the server-marked active figure is pulled into it with
     order:-1. `.is-carousel` (added by the runtime, which sets scrollLeft in
     the same synchronous block) is what turns the row into a real scroller. */
  @media screen and (max-width: 749px) {
    #vtls-pi-{{ section.id }} .vtls-pi__media-list {
      display: flex;
      /* center, not stretch: each slide keeps its own ratio box hugging the
         media (radius stays on the image edge); shorter slides ride centered
         in the row, whose height follows the tallest slide. */
      align-items: center;
      /* Every slide stays IN FLOW while clipped (rather than display:none on
         the inactive ones) so the row already has its final carousel height
         — flipping to the scroller cannot shift the page. */
      overflow: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__media-list::-webkit-scrollbar { display: none; }
    #vtls-pi-{{ section.id }} .vtls-pi__media-item {
      flex: 0 0 100%;
      width: 100%;
    }
    /* Pre-JS only: hoist the active figure into the single visible slot, so
       slot 0 at scrollLeft 0 IS the hero. Keyed off .is-active (not a Liquid
       index) so it follows the runtime if a variant switch lands before the
       flip. `.is-carousel` below puts it back in natural order. */
    #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-active { order: -1; }
    /* Variant-hidden media stay out of the slide row. */
    #vtls-pi-{{ section.id }} .vtls-pi__media-item[hidden] { display: none; }
    /* The cross-fade is desktop-only; neutralize a stray .is-leaving (e.g.
       a resize mid-fade) so it can't absolutely cover the carousel. */
    #vtls-pi-{{ section.id }} .vtls-pi__media-item.is-leaving {
      position: static;
      opacity: 1;
      transition: none;
    }
    /* Runtime-enabled scroller. enableMediaCarousel() adds this class and
       sets scrollLeft in the SAME task, so no frame can paint the row in
       natural order but still unscrolled. Restoring order:0 here beats the
       order:-1 rule on specificity (4 classes vs 2), not on source order. */
    #vtls-pi-{{ section.id }} .vtls-pi__media-list.is-carousel {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__media-list.is-carousel .vtls-pi__media-item {
      scroll-snap-align: center;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__media-list.is-carousel .vtls-pi__media-item.is-active {
      order: 0;
    }
  }
  /* Prev/next arrows over the main media (Horizon-style, same circle
     treatment as the zoom close button). */
  #vtls-pi-{{ section.id }} .vtls-pi__media-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    color: #222222;
    cursor: pointer;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__media-nav--prev { left: 0.8rem; }
  #vtls-pi-{{ section.id }} .vtls-pi__media-nav--next { right: 0.8rem; }
  /* One-row swipe/scroll carousel on EVERY viewport (desktop adopted the
     mobile pattern): no wrap, hidden scrollbar, edge fade from the runtime's
     scroll-hint mask (bindThumbHint). When every thumb fits, the runtime adds
     .is-fit and desktop centers the row under the photo instead. */
  #vtls-pi-{{ section.id }} .vtls-pi__thumbs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    gap: 0.6rem;
    margin-top: 1rem;
    /* zero the residual bottom margin the theme's <ul> reset leaks in — it
       escapes the media column and shows as empty space below the gallery. */
    margin-bottom: 0;
    list-style: none;
    padding: 0;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__thumbs::-webkit-scrollbar { display: none; }
  @media screen and (min-width: 750px) {
    /* Centered only when they all fit (.is-fit means no overflow, so center
       cannot clip the row's left edge). Mobile deliberately stays
       left-aligned per the mobile-thumbnails spec. */
    #vtls-pi-{{ section.id }} .vtls-pi__thumbs.is-fit { justify-content: center; }
  }
  #vtls-pi-{{ section.id }} .vtls-pi__thumbs li { flex: 0 0 auto; }
  #vtls-pi-{{ section.id }} .vtls-pi__thumb {
    /* block, not the default inline-block: an inline-level button sits on
       the li's text baseline, whose strut descender adds a few px of dead
       space under every thumb — the residual "bottom padding" below the
       strip (the zoom rail's .vtls-pi__zoom-thumb already ships block). */
    display: block;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: none;
    cursor: pointer;
    overflow: hidden;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__thumb.is-active {
    border-color: currentColor;
    border-width: 2px;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Desktop: larger gallery thumbnails (Atlas reference ~90px), kept square.
     Mobile keeps the base 64px in the one-row swipe carousel. */
  @media screen and (min-width: 750px) {
    #vtls-pi-{{ section.id }} .vtls-pi__thumb { width: 90px; height: 90px; }
  }
  {%- comment -%}
    The one-row carousel rules (nowrap, hidden scrollbar, runtime edge-fade
    mask) moved to the base .vtls-pi__thumbs block above when desktop adopted
    the mobile pattern — the former 749px-only media query is gone. Mobile
    behavior is unchanged; the gallery keeps the section's mobile left-right
    padding (no full-bleed break-out for the strip).
  {%- endcomment -%}

  /* ---- media zoom lightbox (Horizon-style) ----
     Deliberately NOT :where()-wrapped: this is our overlay UI, so id-level
     specificity + explicit resets keep any theme `button`/`dialog` rule out. */
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-open {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    cursor: zoom-in;
    z-index: 1;
    -webkit-tap-highlight-color: transparent;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-open:hover,
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-open:active {
    background: transparent;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-open:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-dialog {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100vh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: {{ zoom_dialog_bg }};
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-dialog::-webkit-scrollbar { display: none; }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-dialog::backdrop { background: transparent; }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-dialog[open] { animation: vtls-pi-zoom-fade 0.2s ease; }
  @keyframes vtls-pi-zoom-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-dialog[open] { animation: none; }
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-close {
    position: fixed;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: none;
    color: #222222;
    cursor: pointer;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-item { margin: 0; }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-item--image { cursor: zoom-out; }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-pan > img,
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-item > img,
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-item > video {
    display: block;
    width: 100%;
    height: auto;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-item > iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs-rail {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0.8rem;
    padding-bottom: calc(0.8rem + env(safe-area-inset-bottom, 0px));
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    pointer-events: auto;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs::-webkit-scrollbar { display: none; }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs li {
    margin: 0;
    flex: 0 0 auto;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumb {
    display: block;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: none;
    cursor: pointer;
    overflow: hidden;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumb.is-active {
    border-color: currentColor;
    border-width: 2px;
  }
  #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media screen and (min-width: 750px) {
    /* Desktop: thumbnail rail fixed on the right, vertically centered. */
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs-rail {
      left: auto;
      right: 1rem;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumbs {
      flex-direction: column;
      max-height: calc(100vh - 160px);
      padding: 0;
      overflow-x: hidden;
      overflow-y: auto;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-thumb {
      width: 56px;
      height: 56px;
    }
  }
  @media screen and (max-width: 749px) {
    /* Mobile: one media per snap slide. The list is a REAL scroller, so a
       horizontal swipe moves between media exactly like the page gallery
       (CON-3510); the thumbnail rail stays as the direct-jump navigation and
       the IntersectionObserver keeps it in sync with whatever the swipe
       lands on. Which gesture wins is decided by touch-action on the pan
       wrapper below, not here. */
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-list {
      display: flex;
      height: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-list::-webkit-scrollbar { display: none; }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-item {
      flex: 0 0 100%;
      scroll-snap-align: start;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-item--image { cursor: default; }
    /* Gesture arbitration (CON-3510). Fit-to-screen is the common state, so
       it gets the swipe: pan-x lets the browser scroll the slide row itself
       (native, interruptible, snaps), while pinch-zoom keeps two-finger zoom
       working and the omitted double-tap-zoom stays suppressed so our own
       double-tap handler owns it. The moment the image is actually zoomed IN
       the same horizontal drag has to pan the image instead, so the runtime
       flips .is-zoomed and takes the touches back. */
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-pan {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      touch-action: pan-x pinch-zoom;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-pan.is-zoomed { touch-action: none; }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-item > img,
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-item > video,
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-pan > img {
      /* Fill the available space (was width/height:auto, which left small
         source images tiny and centered). object-fit keeps the aspect ratio
         and never distorts. */
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    #vtls-pi-{{ section.id }} .vtls-pi__zoom-pan > img {
      object-fit: contain;
      transform: scale(var(--vtls-zoom-scale, 1)) translate(var(--vtls-zoom-x, 0px), var(--vtls-zoom-y, 0px));
    }
  }

  /* ---- info column: zero-specificity fallbacks so theme styles win ---- */
  :where(#vtls-pi-{{ section.id }} .vtls-pi__info) > * + * { margin-top: 1.2rem; }
  :where(.vtls-pi__divider) { border: 0; border-top: 1px solid rgba(0, 0, 0, 0.12); margin: 0; }
  :where(.vtls-pi__title h1, .vtls-pi__title h2) { margin: 0; }
  :where(.vtls-pi__price-row) {
