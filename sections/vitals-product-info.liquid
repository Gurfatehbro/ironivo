  .vtls-pi__inventory.is-low .vtls-pi__dot { background: #ee9441; }
  .vtls-pi__inventory.is-out .vtls-pi__dot { background: #c8c8c8; }

  :where(.vtls-pi__accordion) { border-top: 1px solid rgba(0, 0, 0, 0.12); }
  :where(.vtls-pi__accordion summary) {
