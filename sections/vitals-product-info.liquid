  .vtls-pi__accordion[open] .vtls-pi__accordion-caret { transform: rotate(180deg); }
  :where(.vtls-pi__accordion-content) { padding: 0 0 1.2rem; line-height: 1.6; }

  /* VTLS_PAGEGEN_ICONS -- the shared PageGen icon library (data-URI CSS masks,
     assets/pagegen-icons.css from the theme-app-extension) is inlined below so
     the badges / benefits / product tabs blocks use the exact same icons as
     the PageGen app blocks. Rendered as <span class="PgI PgI--<id>">. */
/* PageGen app-block icon library — Font Awesome Free 6.7.2 (https://fontawesome.com, CC BY 4.0), Bootstrap Icons (https://icons.getbootstrap.com, MIT) + Vitals originals. */

/* Icons are data-URI CSS masks: same-document data URIs are exempt from the CDN CORS limitation that blocks */

/* asset-hosted mask files, and living in an asset keeps them outside the 100KB extension Liquid budget. */

/* Rendered by snippets/pagegen-icon.liquid as <span class="PgI PgI--<id>">; blocks size the span, color follows currentColor. */
.PgI {
	display: inline-block;
	flex: 0 0 auto;
	background-color: currentColor;
	/* stylelint-disable-next-line property-no-vendor-prefix -- this asset ships raw (no autoprefixer pass), so Safari needs the prefix */
	-webkit-mask: var(--pgi) no-repeat center/contain;
	mask: var(--pgi) no-repeat center/contain;
}

.PgI--sparkle {
	--pgi: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='3.5%201.5%2019%2019'%3E%3Cpath%20d='M12%201.5l2.1%206.4%206.4%202.1-6.4%202.1L12%2018.5l-2.1-6.4L3.5%2010l6.4-2.1z'/%3E%3Cpath%20d='M19%2013.5l.85%202.65L22.5%2017l-2.65.85L19%2020.5l-.85-2.65L15.5%2017l2.65-.85z'/%3E%3C/svg%3E");

	/* the diamond star fills little of its bounding box vs the mostly-solid FA glyphs — bump it slightly so it reads the same size (CON-3305) */
	transform: scale(1.15);
}

.PgI--check_circle {
	--pgi: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20512%20512'%3E%3Cpath%20d='M256%20512A256%20256%200%201%200%20256%200a256%20256%200%201%200%200%20512zM369%20209L241%20337c-9.4%209.4-24.6%209.4-33.9%200l-64-64c-9.4-9.4-9.4-24.6%200-33.9s24.6-9.4%2033.9%200l47%2047L335%20175c9.4-9.4%2024.6-9.4%2033.9%200s9.4%2024.6%200%2033.9z'/%3E%3C/svg%3E");
}

.PgI--check {
	--pgi: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20448%20512'%3E%3Cpath%20d='M438.6%20105.4c12.5%2012.5%2012.5%2032.8%200%2045.3l-256%20256c-12.5%2012.5-32.8%2012.5-45.3%200l-128-128c-12.5-12.5-12.5-32.8%200-45.3s32.8-12.5%2045.3%200L160%20338.7%20393.4%20105.4c12.5-12.5%2032.8-12.5%2045.3%200z'/%3E%3C/svg%3E");
}

.PgI--check-circle {
	--pgi: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20512%20512'%3E%3Cpath%20d='M256%2048a208%20208%200%201%201%200%20416%20208%20208%200%201%201%200-416zm0%20464A256%20256%200%201%200%20256%200a256%20256%200%201%200%200%20512zM369%20209c9.4-9.4%209.4-24.6%200-33.9s-24.6-9.4-33.9%200l-111%20111-47-47c-9.4-9.4-24.6-9.4-33.9%200s-9.4%2024.6%200%2033.9l64%2064c9.4%209.4%2024.6%209.4%2033.9%200L369%20209z'/%3E%3C/svg%3E");
