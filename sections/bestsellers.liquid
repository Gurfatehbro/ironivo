{% comment %}
  Bestsellers Featured Collection Section
{% endcomment %}

<div class="preview-products-section">
  <div class="page-width">
    <div class="preview-section-header pro-animate-on-scroll">
      <div class="pro-section-tag">{{ section.settings.tag | default: 'FEATURED GEAR' }}</div>
      <h2 class="preview-section-title">{{ section.settings.title | default: 'TOP RATED PERFORMANCE TOOLS' }}</h2>
      <p class="preview-section-subtitle">{{ section.settings.subtitle | default: 'Engineered to elevate your grip, forearm strength, and joint health.' }}</p>
    </div>

    <div class="preview-grid pro-animate-on-scroll">
      {%- assign collection = section.settings.collection -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: 4 -%}
          <div class="preview-card">
            <div class="preview-card-image-wrap">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="preview-card-image" loading="lazy">
              {%- else -%}
                <img src="{{ 'product-hero.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="preview-card-image" loading="lazy">
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">SALE</span>
              {%- endif -%}
            </div>
            <div class="preview-card-content">
              <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(4.9/5)</span></div>
              <h3 class="preview-card-title">{{ product.title }}</h3>
              <div class="preview-card-price-wrap">
                <span class="preview-card-price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="preview-card-compare-price">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <a href="{{ product.url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">View Product 🛒</a>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Out-of-the-box Default Cards -->
        <div class="preview-card">
          <div class="preview-card-image-wrap">
            <img src="{{ 'product-hero.jpg' | asset_url }}" alt="Ironivo Finger & Hand Grip Pro" class="preview-card-image" loading="lazy">
            <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">SAVE 30%</span>
          </div>
          <div class="preview-card-content">
            <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(428 reviews)</span></div>
            <h3 class="preview-card-title">Ironivo Finger & Hand Grip Pro</h3>
            <div class="preview-card-price-wrap">
              <span class="preview-card-price">$34.99</span>
              <span class="preview-card-compare-price">$49.99</span>
            </div>
            <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">Shop Now 🛒</a>
          </div>
        </div>

        <div class="preview-card">
          <div class="preview-card-image-wrap">
            <img src="{{ 'hand-training.jpg' | asset_url }}" alt="Ironivo Heavy Duty Hand Gripper" class="preview-card-image" loading="lazy">
            <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">BESTSELLER</span>
          </div>
          <div class="preview-card-content">
            <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(312 reviews)</span></div>
            <h3 class="preview-card-title">Ironivo Heavy Duty Hand Gripper</h3>
            <div class="preview-card-price-wrap">
              <span class="preview-card-price">$29.99</span>
              <span class="preview-card-compare-price">$39.99</span>
            </div>
            <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">Shop Now 🛒</a>
          </div>
        </div>

        <div class="preview-card">
          <div class="preview-card-image-wrap">
            <img src="{{ 'ironivo-emblem.jpg' | asset_url }}" alt="Ironivo Complete Athlete Kit" class="preview-card-image" loading="lazy">
            <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">BUNDLE & SAVE</span>
          </div>
          <div class="preview-card-content">
            <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(890 reviews)</span></div>
            <h3 class="preview-card-title">Ironivo Complete Athlete Kit</h3>
            <div class="preview-card-price-wrap">
              <span class="preview-card-price">$59.99</span>
              <span class="preview-card-compare-price">$89.99</span>
            </div>
            <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">Shop Now 🛒</a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bestsellers Grid",
  "tag": "section",
  "class": "section-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section Tag",
      "default": "FEATURED GEAR"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "TOP RATED PERFORMANCE TOOLS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Engineered to elevate your grip, forearm strength, and joint health."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Grid"
    }
  ]
}
{% endschema %}
