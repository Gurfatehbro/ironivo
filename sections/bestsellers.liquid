{% comment %}
  Bestsellers Section - The 2 Flagship Essentials + Bundle
{% endcomment %}

<div id="pro-bestsellers" class="preview-products-section">
  <div class="page-width">
    <div class="preview-section-header pro-animate-on-scroll">
      <div class="pro-section-tag">{{ section.settings.tag | default: 'THE 2 FLAGSHIP ESSENTIALS' }}</div>
      <h2 class="preview-section-title">{{ section.settings.title | default: 'ENGINEERED FOR SUPREME STRENGTH' }}</h2>
      <p class="preview-section-subtitle">{{ section.settings.subtitle | default: 'Select your performance gear below with 30-day money-back guarantee.' }}</p>
    </div>

    <div class="preview-grid pro-animate-on-scroll" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
      <!-- Product 1: Eagle Claw Gripper -->
      <div class="preview-card">
        <div class="preview-card-image-wrap">
          <img src="{{ 'eagle-claw-gripper.jpg' | asset_url }}" alt="Ironivo Eagle Claw 5-Finger Gripper" class="preview-card-image" loading="lazy">
          <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">BESTSELLER • SAVE 30%</span>
        </div>
        <div class="preview-card-content">
          <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(428 verified reviews)</span></div>
          <h3 class="preview-card-title">Ironivo Eagle Claw 5-Finger Gripper</h3>
          <p style="font-size: 1.35rem; color: #64748b; margin: 0 0 12px;">Individual 5-finger spring pistons with non-slip fingertip grips.</p>
          <div class="preview-card-price-wrap">
            <span class="preview-card-price">$34.99</span>
            <span class="preview-card-compare-price">$49.99</span>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">Buy Eagle Claw 🛒</a>
        </div>
      </div>

      <!-- Product 2: Powerlifting Lever Belt -->
      <div class="preview-card">
        <div class="preview-card-image-wrap">
          <img src="{{ 'lever-belt.jpg' | asset_url }}" alt="Ironivo 10mm Powerlifting Lever Belt" class="preview-card-image" loading="lazy">
          <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">NEW RELEASE • SAVE 25%</span>
        </div>
        <div class="preview-card-content">
          <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(389 verified reviews)</span></div>
          <h3 class="preview-card-title">Ironivo 10mm Powerlifting Lever Belt</h3>
          <p style="font-size: 1.35rem; color: #64748b; margin: 0 0 12px;">10mm genuine black leather with stainless steel quick-release lever.</p>
          <div class="preview-card-price-wrap">
            <span class="preview-card-price">$79.99</span>
            <span class="preview-card-compare-price">$109.99</span>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="text-decoration: none; text-align: center; display: block;">Buy Lever Belt 🛒</a>
        </div>
      </div>

      <!-- Product 3: Power Athlete Bundle -->
      <div class="preview-card" style="border: 2px solid #ff4757; position: relative;">
        <div style="position: absolute; top: 0; right: 0; background: #ff4757; color: #ffffff; font-size: 1.1rem; font-weight: 800; padding: 4px 12px; border-bottom-left-radius: 8px; z-index: 10;">
          MOST POPULAR
        </div>
        <div class="preview-card-image-wrap">
          <img src="{{ 'ironivo-emblem.jpg' | asset_url }}" alt="Ironivo Ultimate Power Combo" class="preview-card-image" loading="lazy">
          <span class="badge badge--sale" style="position: absolute; top: 12px; left: 12px;">COMBO • SAVE $30</span>
        </div>
        <div class="preview-card-content">
          <div class="preview-card-stars">★★★★★ <span style="color: #64748b; font-size: 1.2rem;">(712 verified reviews)</span></div>
          <h3 class="preview-card-title">Ironivo Ultimate Strength Bundle</h3>
          <p style="font-size: 1.35rem; color: #64748b; margin: 0 0 12px;">Includes Eagle Claw Gripper + 10mm Lever Belt + Travel Bag.</p>
          <div class="preview-card-price-wrap">
            <span class="preview-card-price">$99.99</span>
            <span class="preview-card-compare-price">$129.99</span>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="preview-card-btn" style="background: #ff4757; text-decoration: none; text-align: center; display: block;">Get The Bundle ⚡</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bestsellers Grid",
  "tag": "section",
  "class": "section-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section Tag",
      "default": "THE 2 FLAGSHIP ESSENTIALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ENGINEERED FOR SUPREME STRENGTH"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select your performance gear below with 30-day money-back guarantee."
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Grid"
    }
  ]
}
{% endschema %}
