{% doc %}
  @prompt
    Create a complete product page template with product images gallery on the left, product title, price, description, variant selectors (size, color), add to cart button, and quantity selector on the right. Make it clean and modern.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-gallery-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-product-main-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-product-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-thumbnails-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 12px;
  }

  .ai-product-thumbnail-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    cursor: pointer;
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .ai-product-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.accent_color }};
  }

  .ai-product-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-price-current-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: {{ block.settings.price_size | times: 0.85 }}px;
  }

  .ai-product-price-sale-{{ ai_gen_id }} {
    background-color: {{ block.settings.sale_badge_color }};
    color: {{ block.settings.sale_badge_text_color }};
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-product-variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-variant-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-product-variant-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-product-variant-option-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-variant-option-{{ ai_gen_id }} input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-product-variant-option-{{ ai_gen_id }} label {
    display: inline-block;
    padding: 12px 20px;
    border: 2px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.variant_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-variant-option-{{ ai_gen_id }} input[type="radio"]:checked + label {
    border-color: {{ block.settings.accent_color }};
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.variant_selected_text_color }};
  }

  .ai-product-variant-option-{{ ai_gen_id }} input[type="radio"]:disabled + label {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ai-product-quantity-cart-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .ai-product-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 2px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-quantity-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border: none;
    background-color: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-product-quantity-button-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .ai-product-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 44px;
    border: none;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-product-add-to-cart-{{ ai_gen_id }} {
    flex: 1;
    height: 48px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-availability-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-availability-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .ai-product-availability-dot-{{ ai_gen_id }}.in-stock {
    background-color: #22c55e;
  }

  .ai-product-availability-dot-{{ ai_gen_id }}.out-of-stock {
    background-color: #ef4444;
  }

  @media screen and (max-width: 768px) {
    .ai-product-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.85 }}px;
    }

    .ai-product-quantity-cart-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-product-quantity-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<product-page-{{ ai_gen_id }} class="ai-product-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-container-{{ ai_gen_id }}">
    <div class="ai-product-gallery-{{ ai_gen_id }}">
      <div class="ai-product-main-image-{{ ai_gen_id }}">
        {% if product.featured_media %}
          <img
            src="{{ product.featured_media | image_url: width: 1000 }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="1000"
            height="1000"
            loading="eager"
            data-main-image
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="ai-product-thumbnails-{{ ai_gen_id }}">
          {% for media in product.media limit: 6 %}
            <div class="ai-product-thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-thumbnail data-media-id="{{ media.id }}">
              <img
                src="{{ media | image_url: width: 200 }}"
                alt="{{ media.alt | escape }}"
                width="200"
                height="200"
                loading="lazy"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ai-product-info-{{ ai_gen_id }}">
      <h1 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h1>

      <div class="ai-product-price-{{ ai_gen_id }}" data-price-container>
        <span class="ai-product-price-current-{{ ai_gen_id }}" data-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="ai-product-price-compare-{{ ai_gen_id }}" data-compare-price>
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
          <span class="ai-product-price-sale-{{ ai_gen_id }}">
            Sale
          </span>
        {% endif %}
      </div>

      {% if block.settings.show_availability %}
        <div class="ai-product-availability-{{ ai_gen_id }}" data-availability>
          <span class="ai-product-availability-dot-{{ ai_gen_id }} {% if product.selected_or_first_available_variant.available %}in-stock{% else %}out-of-stock{% endif %}"></span>
          <span>
            {% if product.selected_or_first_available_variant.available %}
              In stock
            {% else %}
              Out of stock
            {% endif %}
          </span>
        </div>
      {% endif %}

      {% if product.description != blank %}
        <div class="ai-product-description-{{ ai_gen_id }}">
          {{ product.description }}
        </div>
      {% endif %}

      <form method="post" action="/cart/add" data-product-form>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          <div class="ai-product-variants-{{ ai_gen_id }}">
            {% for option in product.options_with_values %}
              <div class="ai-product-variant-group-{{ ai_gen_id }}">
                <div class="ai-product-variant-label-{{ ai_gen_id }}">
                  {{ option.name }}: <span data-selected-{{ option.position }}>{{ option.selected_value }}</span>
                </div>
                <div class="ai-product-variant-options-{{ ai_gen_id }}">
                  {% for value in option.values %}
                    <div class="ai-product-variant-option-{{ ai_gen_id }}">
                      <input
                        type="radio"
                        id="option-{{ option.position }}-{{ value | handle }}-{{ ai_gen_id }}"
                        name="options[{{ option.name }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        data-option-input
                        data-option-position="{{ option.position }}"
                      >
                      <label for="option-{{ option.position }}-{{ value | handle }}-{{ ai_gen_id }}">
                        {{ value }}
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="ai-product-quantity-cart-{{ ai_gen_id }}">
          <div class="ai-product-quantity-{{ ai_gen_id }}">
            <button type="button" class="ai-product-quantity-button-{{ ai_gen_id }}" data-quantity-minus aria-label="Decrease quantity">
              −
            </button>
            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              class="ai-product-quantity-input-{{ ai_gen_id }}"
              data-quantity-input
              aria-label="Quantity"
            >
            <button type="button" class="ai-product-quantity-button-{{ ai_gen_id }}" data-quantity-plus aria-label="Increase quantity">
              +
            </button>
          </div>

          <button
            type="submit"
            class="ai-product-add-to-cart-{{ ai_gen_id }}"
            data-add-to-cart
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {% if product.selected_or_first_available_variant.available %}
              {{ block.settings.add_to_cart_text }}
            {% else %}
              Sold out
            {% endif %}
          </button>
        </div>
      </form>
    </div>
  </div>
</product-page-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.product = {{ product | json }};
        this.currentVariant = {{ product.selected_or_first_available_variant | json }};
      }

      connectedCallback() {
        this.mainImage = this.querySelector('[data-main-image]');
        this.thumbnails = this.querySelectorAll('[data-thumbnail]');
        this.form = this.querySelector('[data-product-form]');
        this.variantIdInput = this.querySelector('[data-variant-id]');
        this.optionInputs = this.querySelectorAll('[data-option-input]');
        this.quantityInput = this.querySelector('[data-quantity-input]');
        this.quantityMinus = this.querySelector('[data-quantity-minus]');
        this.quantityPlus = this.querySelector('[data-quantity-plus]');
        this.addToCartButton = this.querySelector('[data-add-to-cart]');
        this.priceContainer = this.querySelector('[data-price-container]');
        this.availabilityContainer = this.querySelector('[data-availability]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => this.handleThumbnailClick(thumbnail));
        });

        this.optionInputs.forEach((input) => {
          input.addEventListener('change', () => this.handleOptionChange());
        });

        this.quantityMinus.addEventListener('click', () => this.decreaseQuantity());
        this.quantityPlus.addEventListener('click', () => this.increaseQuantity());

        this.form.addEventListener('submit', (e) => this.handleFormSubmit(e));
      }

      handleThumbnailClick(thumbnail) {
        this.thumbnails.forEach((t) => t.classList.remove('active'));
        thumbnail.classList.add('active');

        const mediaId = thumbnail.dataset.mediaId;
        const media = this.product.media.find((m) => m.id == mediaId);

        if (media && this.mainImage) {
          this.mainImage.src = media.src;
          this.mainImage.alt = media.alt || '';
        }
      }

      handleOptionChange() {
        const selectedOptions = {};
        this.optionInputs.forEach((input) => {
          if (input.checked) {
            const position = input.dataset.optionPosition;
            selectedOptions[position] = input.value;
            const selectedSpan = this.querySelector(`[data-selected-${position}]`);
            if (selectedSpan) {
              selectedSpan.textContent = input.value;
            }
          }
        });

        const variant = this.product.variants.find((v) => {
          return v.option1 === selectedOptions['1'] &&
                 (v.option2 === selectedOptions['2'] || !selectedOptions['2']) &&
                 (v.option3 === selectedOptions['3'] || !selectedOptions['3']);
        });

        if (variant) {
          this.currentVariant = variant;
          this.updateVariant(variant);
        }
      }

      updateVariant(variant) {
        this.variantIdInput.value = variant.id;

        const priceElement = this.priceContainer.querySelector('[data-price]');
        if (priceElement) {
          priceElement.textContent = this.formatMoney(variant.price);
        }

        const comparePriceElement = this.priceContainer.querySelector('[data-compare-price]');
        const saleBadge = this.priceContainer.querySelector('.ai-product-price-sale-{{ ai_gen_id }}');

        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          if (comparePriceElement) {
            comparePriceElement.textContent = this.formatMoney(variant.compare_at_price);
            comparePriceElement.style.display = 'inline';
          }
          if (saleBadge) {
            saleBadge.style.display = 'inline-block';
          }
        } else {
          if (comparePriceElement) {
            comparePriceElement.style.display = 'none';
          }
          if (saleBadge) {
            saleBadge.style.display = 'none';
          }
        }

        if (this.availabilityContainer) {
          const dot = this.availabilityContainer.querySelector('.ai-product-availability-dot-{{ ai_gen_id }}');
          const text = this.availabilityContainer.querySelector('span:last-child');

          if (variant.available) {
            dot.classList.remove('out-of-stock');
            dot.classList.add('in-stock');
            text.textContent = 'In stock';
            this.addToCartButton.disabled = false;
            this.addToCartButton.textContent = '{{ block.settings.add_to_cart_text }}';
          } else {
            dot.classList.remove('in-stock');
            dot.classList.add('out-of-stock');
            text.textContent = 'Out of stock';
            this.addToCartButton.disabled = true;
            this.addToCartButton.textContent = 'Sold out';
          }
        }

        if (variant.featured_media) {
          const thumbnail = this.querySelector(`[data-media-id="${variant.featured_media.id}"]`);
          if (thumbnail) {
            this.handleThumbnailClick(thumbnail);
          }
        }
      }

      decreaseQuantity() {
        const currentValue = parseInt(this.quantityInput.value);
        if (currentValue > 1) {
          this.quantityInput.value = currentValue - 1;
        }
      }

      increaseQuantity() {
        const currentValue = parseInt(this.quantityInput.value);
        this.quantityInput.value = currentValue + 1;
      }

      handleFormSubmit(e) {
        e.preventDefault();

        const formData = new FormData(this.form);

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          window.location.href = '/cart';
        })
        .catch(error => {
          console.error('Error:', error);
        });
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return '{{ cart.currency.symbol }}' + amount.toFixed(2);
      }
    }

    customElements.define('product-page-{{ ai_gen_id }}', ProductPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
